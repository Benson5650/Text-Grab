<Window
    x:Class="Text_Grab.Views.GrabFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="GrabFrameWindow"
    Title="擷取框"
    Width="800"
    Height="450"
    MinWidth="150"
    MinHeight="150"
    Activated="GrabFrameWindow_Activated"
    AllowDrop="True"
    AllowsTransparency="True"
    AutomationProperties.AutomationId="GrabFrameWindow"
    Background="Transparent"
    BorderBrush="{ui:ThemeResource ApplicationBackgroundBrush}"
    BorderThickness="1"
    Closed="Window_Closed"
    Closing="GrabFrameWindow_Closing"
    Deactivated="GrabFrameWindow_Deactivated"
    DragLeave="GrabFrameWindow_DragLeave"
    DragOver="GrabFrameWindow_DragOver"
    Drop="GrabFrameWindow_Drop"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    Initialized="GrabFrameWindow_Initialized"
    Loaded="GrabFrame_Loaded"
    LocationChanged="Window_LocationChanged"
    ResizeMode="CanResizeWithGrip"
    SizeChanged="Window_SizeChanged"
    Topmost="True"
    Unloaded="GrabFrame_Unloaded"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <BitmapImage x:Key="TextGrabIcon" UriSource="/Text-Grab;component/Images/TealSelect40.png" />
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding
            CanExecute="CanPasteExecute"
            Command="{x:Static local:GrabFrame.PasteCommand}"
            Executed="PasteExecuted" />
        <CommandBinding
            CanExecute="CanUndoCommand"
            Command="{x:Static local:GrabFrame.UndoCommand}"
            Executed="UndoExecuted" />
        <CommandBinding
            CanExecute="CanRedoExecuted"
            Command="{x:Static local:GrabFrame.RedoCommand}"
            Executed="RedoExecuted" />
        <CommandBinding
            CanExecute="CanChangeWordBorderExecute"
            Command="{x:Static local:GrabFrame.DeleteWordsCommand}"
            Executed="DeleteWordBordersExecuted" />
        <CommandBinding
            CanExecute="CanExecuteMergeWordBorders"
            Command="{x:Static local:GrabFrame.MergeWordsCommand}"
            Executed="MergeWordBordersExecuted" />
        <CommandBinding
            CanExecute="CanExecuteGrab"
            Command="{x:Static local:GrabFrame.GrabCommand}"
            Executed="GrabExecuted" />
        <CommandBinding
            CanExecute="CanExecuteGrab"
            Command="{x:Static local:GrabFrame.GrabTrimCommand}"
            Executed="GrabTrimExecuted" />
    </Window.CommandBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="18,18,2,18"
            GlassFrameThickness="0"
            ResizeBorderThickness="8" />
    </WindowChrome.WindowChrome>
    <Border
        x:Name="FrameBorder"
        AutomationProperties.AutomationId="GrabFrame.FrameBorder"
        BorderBrush="{ui:ThemeResource ApplicationBackgroundBrush}"
        BorderThickness="2"
        ClipToBounds="True">
        <Grid ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                VerticalAlignment="Top"
                Background="{ui:ThemeResource ApplicationBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Menu
                    Height="32"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="檔案" SubmenuOpened="MenuItem_SubmenuOpened">
                        <MenuItem
                            x:Name="AutoOcrCheckBox"
                            AutomationProperties.AutomationId="GrabFrame.Menu.AutoOcr"
                            Click="AutoOcrCheckBox_Click"
                            Header="自動開始 OCR"
                            IsCheckable="True"
                            IsChecked="True" />
                        <MenuItem
                            x:Name="AlwaysUpdateEtwCheckBox"
                            AutomationProperties.AutomationId="GrabFrame.Menu.UpdateEditText"
                            Header="自動更新文字編輯視窗中的內容"
                            IsCheckable="True"
                            IsChecked="True" />
                        <MenuItem
                            x:Name="ReadBarcodesMenuItem"
                            AutomationProperties.AutomationId="GrabFrame.Menu.ReadBarcodes"
                            Checked="ReadBarcodesMenuItem_Checked"
                            Header="嘗試讀取條碼與 QR Code"
                            IsCheckable="True"
                            Unchecked="ReadBarcodesMenuItem_Checked" />
                        <MenuItem Header="文字分組">
                            <MenuItem
                                x:Name="WordGroupingWordMenuItem"
                                Click="WordGroupingMenuItem_Click"
                                Header="字詞"
                                IsCheckable="True"
                                Tag="Word" />
                            <MenuItem
                                x:Name="WordGroupingLineMenuItem"
                                Click="WordGroupingMenuItem_Click"
                                Header="行"
                                IsCheckable="True"
                                Tag="Line" />
                            <MenuItem
                                x:Name="WordGroupingParagraphMenuItem"
                                Click="WordGroupingMenuItem_Click"
                                Header="段落"
                                IsCheckable="True"
                                Tag="Paragraph" />
                            <MenuItem
                                x:Name="WordGroupingWindowMenuItem"
                                Click="WordGroupingMenuItem_Click"
                                Header="視窗"
                                IsCheckable="True"
                                Tag="Window" />
                        </MenuItem>
                        <MenuItem
                            x:Name="IsTopmostMenuItem"
                            AutomationProperties.AutomationId="GrabFrame.Menu.Topmost"
                            Header="讓擷取框保持最上層"
                            IsCheckable="True"
                            IsChecked="{Binding Topmost, ElementName=GrabFrameWindow, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem x:Name="TranslationMenuItem" Header="翻譯為...">
                            <MenuItem
                                x:Name="EnableTranslationMenuItem"
                                AutomationProperties.AutomationId="GrabFrame.Menu.EnableTranslation"
                                Click="EnableTranslationMenuItem_Click"
                                Header="啟用即時翻譯"
                                IsCheckable="True" />
                            <Separator />
                            <MenuItem Header="目標語言">
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="英文"
                                    IsCheckable="True"
                                    Tag="English" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="西班牙文"
                                    IsCheckable="True"
                                    Tag="Spanish" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="法文"
                                    IsCheckable="True"
                                    Tag="French" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="德文"
                                    IsCheckable="True"
                                    Tag="German" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="義大利文"
                                    IsCheckable="True"
                                    Tag="Italian" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="葡萄牙文"
                                    IsCheckable="True"
                                    Tag="Portuguese" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="俄文"
                                    IsCheckable="True"
                                    Tag="Russian" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="日文"
                                    IsCheckable="True"
                                    Tag="Japanese" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="簡體中文"
                                    IsCheckable="True"
                                    Tag="Chinese (Simplified)" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="韓文"
                                    IsCheckable="True"
                                    Tag="Korean" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="阿拉伯文"
                                    IsCheckable="True"
                                    Tag="Arabic" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="印地文"
                                    IsCheckable="True"
                                    Tag="Hindi" />
                            </MenuItem>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{x:Static local:GrabFrame.PasteCommand}"
                            Header="貼上圖片"
                            InputGestureText="Ctrl + Shift + V" />
                        <MenuItem
                            Click="OpenImageMenuItem_Click"
                            Header="開啟圖片或 PDF..."
                            InputGestureText="Ctrl + O" />
                        <MenuItem Click="CaptureFromCameraMenuItem_Click" Header="從相機擷取..." />
                        <MenuItem Click="OpenGrabFrameFileMenuItem_Click" Header="開啟擷取框檔案..." />
                        <MenuItem
                            Click="SaveGrabFrameFileMenuItem_Click"
                            Header="儲存擷取框檔案..."
                            InputGestureText="Ctrl + S" />
                        <MenuItem x:Name="OpenRecentGrabsMenuItem" Header="最近擷取" />
                        <MenuItem x:Name="OpenRecentPdfsMenuItem" Header="最近的 PDF" />
                        <Separator />
                        <MenuItem
                            Name="GrabMenuItem"
                            AutomationProperties.AutomationId="GrabFrame.Menu.Grab"
                            Command="{x:Static local:GrabFrame.GrabCommand}"
                            Header="_Grab"
                            InputGestureText="Ctrl + G" />
                        <MenuItem
                            Name="GrabTrimSingleMenuItem"
                            AutomationProperties.AutomationId="GrabFrame.Menu.GrabSingleLine"
                            Command="{x:Static local:GrabFrame.GrabTrimCommand}"
                            Header="將擷取文字合併為單行"
                            InputGestureText="Ctrl + Shift + G" />
                        <Separator />
                        <MenuItem
                            Name="ManageGrabTemplatesMenuItem"
                            AutomationProperties.AutomationId="GrabFrame.Menu.ManageTemplates"
                            Click="ManageGrabTemplates_Click"
                            Header="管理擷取範本..." />
                        <MenuItem
                            Name="SettingsMenuItem"
                            AutomationProperties.AutomationId="GrabFrame.Menu.OpenSettings"
                            Click="SettingsBTN_Click"
                            Header="Text Grab 設定" />
                        <MenuItem
                            Name="CloseMenuItem"
                            AutomationProperties.AutomationId="GrabFrame.Menu.Close"
                            Click="OnCloseButtonClick"
                            Header="關閉"
                            InputGestureText="Alt + F4" />
                    </MenuItem>
                    <MenuItem Header="編輯">
                        <MenuItem
                            Name="RedoMenuItem"
                            Command="{x:Static local:GrabFrame.RedoCommand}"
                            Header="重做"
                            InputGestureText="Ctrl + Y" />
                        <MenuItem
                            Name="UndoMenuItem"
                            Command="{x:Static local:GrabFrame.UndoCommand}"
                            Header="復原"
                            InputGestureText="Ctrl + Z" />
                        <MenuItem
                            Name="SelectAllMenuItem"
                            Click="SelectAllWordBorders"
                            Header="全選"
                            InputGestureText="Ctrl + A" />
                        <MenuItem
                            Name="AddEditOcrMenuItem"
                            Header="新增、移動或調整行的大小"
                            InputGestureText="按住 Ctrl"
                            IsCheckable="True" />
                        <Separator />
                        <MenuItem Header="編輯圖片">
                            <MenuItem
                                Name="InvertColorsMI"
                                Click="InvertColorsMI_Click"
                                Header="反轉色彩" />
                            <MenuItem
                                Name="AutoContrastMI"
                                Click="AutoContrastMI_Click"
                                Header="增加對比（Sigmoid）" />
                            <MenuItem
                                Name="BrightenMI"
                                Click="BrightenMI_Click"
                                Header="變亮" />
                            <MenuItem
                                Name="DarkenMI"
                                Click="DarkenMI_Click"
                                Header="變暗" />
                            <MenuItem
                                Name="GrayscaleMI"
                                Click="GrayscaleMI_Click"
                                Header="灰階" />
                        </MenuItem>
                        <MenuItem
                            Click="RefreshBTN_Click"
                            Header="重新整理擷取框 OCR 結果"
                            InputGestureText="(Ctrl + R)" />
                        <MenuItem
                            Checked="AspectRationMI_Checked"
                            Header="維持長寬比"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked, ElementName=AspectRationMI, Mode=TwoWay}"
                            Unchecked="AspectRationMI_Checked" />
                        <MenuItem
                            Click="FreezeToggleButton_Click"
                            Header="凍結框內圖片"
                            InputGestureText="F"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked, ElementName=FreezeToggleButton, Mode=TwoWay}" />
                        <MenuItem
                            Click="TableToggleButton_Click"
                            Header="分析為表格"
                            InputGestureText="T"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked, ElementName=TableToggleButton, Mode=TwoWay}" />
                        <MenuItem x:Name="EditTableMenuItem" Header="表格">
                            <MenuItem
                                x:Name="AddTableRowMenuItem"
                                Click="AddTableRowMenuItem_Click"
                                Header="新增資料列" />
                            <MenuItem
                                x:Name="AddTableColumnMenuItem"
                                Click="AddTableColumnMenuItem_Click"
                                Header="新增欄" />
                            <Separator />
                            <MenuItem
                                x:Name="CancelTablePlacementMenuItem"
                                Click="CancelTablePlacement_Click"
                                Header="取消放置" />
                        </MenuItem>
                        <MenuItem
                            Click="EditToggleButton_Click"
                            Header="允許編輯辨識出的文字"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked, ElementName=EditToggleButton, Mode=TwoWay}" />
                        <MenuItem
                            Click="EditTextBTN_Click"
                            Header="將結果傳送至文字編輯視窗"
                            InputGestureText="E"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked, ElementName=EditTextToggleButton, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem
                            x:Name="InvertSelectionMenuItem"
                            Click="InvertSelection"
                            Header="反轉選取"
                            InputGestureText="Ctrl + I" />
                        <MenuItem
                            Command="{x:Static local:GrabFrame.MergeWordsCommand}"
                            Header="合併文字邊界"
                            InputGestureText="Ctrl + M" />
                        <MenuItem
                            Command="{x:Static local:GrabFrame.DeleteWordsCommand}"
                            Header="刪除選取文字"
                            InputGestureText="Del" />
                        <Separator />
                    </MenuItem>
                    <MenuItem Header="檢視">
                        <ui:MenuItem
                            x:Name="NoScrollBehaviorMenuItem"
                            Click="ScrollBehaviorMenuItem_Click"
                            Header="捲動不執行動作"
                            IsCheckable="True"
                            Tag="None" />
                        <MenuItem
                            x:Name="ResizeScrollMenuItem"
                            Click="ScrollBehaviorMenuItem_Click"
                            Header="捲動以調整擷取框大小"
                            IsCheckable="True"
                            Tag="Resize" />
                        <MenuItem
                            x:Name="ZoomScrollMenuItem"
                            Click="ScrollBehaviorMenuItem_Click"
                            Header="捲動以縮放擷取框（預覽）"
                            IsCheckable="True"
                            Tag="Zoom" />
                        <MenuItem
                            x:Name="ZoomWhenFrozenScrollMenuItem"
                            Click="ScrollBehaviorMenuItem_Click"
                            Header="凍結時縮放"
                            IsCheckable="True"
                            Tag="ZoomWhenFrozen" />
                        <Separator />
                        <MenuItem
                            x:Name="ScaleUpMenuItem"
                            Click="ScaleUpMenuItem_Click"
                            Header="放大" />
                        <MenuItem
                            x:Name="ScaleDownMenuItem"
                            Click="ScaleDownMenuItem_Click"
                            Header="縮小" />
                        <Separator />
                        <MenuItem
                            x:Name="ResetViewMenuItem"
                            Click="ResetViewMenuItem_Click"
                            Header="重設檢視"
                            InputGestureText="按滑鼠中鍵" />
                        <Separator />
                        <MenuItem
                            x:Name="ShowWordBordersMenuItem"
                            Click="ShowWordBordersMenuItem_Click"
                            Header="顯示文字邊界"
                            IsCheckable="True"
                            IsChecked="True" />
                        <MenuItem x:Name="FrameBorderMenuItem" Header="擷取框邊界">
                            <MenuItem
                                x:Name="BorderStyleThemeMenuItem"
                                Click="BorderStyleMenuItem_Click"
                                Header="佈景主題（預設）"
                                IsCheckable="True"
                                Tag="Theme" />
                            <MenuItem
                                x:Name="BorderStyleHighContrastMenuItem"
                                Click="BorderStyleMenuItem_Click"
                                Header="高對比（黑白）"
                                IsCheckable="True"
                                Tag="HighContrast" />
                            <Separator />
                            <MenuItem x:Name="BorderColorMenuItem" Header="選擇色彩">
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="藍綠色"
                                    IsCheckable="True"
                                    Tag="#2A767E" />
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="紅色"
                                    IsCheckable="True"
                                    Tag="#E03B3B" />
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="橘色"
                                    IsCheckable="True"
                                    Tag="#E0781E" />
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="黃色"
                                    IsCheckable="True"
                                    Tag="#E0C81E" />
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="綠色"
                                    IsCheckable="True"
                                    Tag="#3BB143" />
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="藍色"
                                    IsCheckable="True"
                                    Tag="#2A7EE0" />
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="紫色"
                                    IsCheckable="True"
                                    Tag="#8A5CD1" />
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="白色"
                                    IsCheckable="True"
                                    Tag="#FFFFFF" />
                                <MenuItem
                                    Click="BorderColorMenuItem_Click"
                                    Header="黑色"
                                    IsCheckable="True"
                                    Tag="#000000" />
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="覆疊不透明度">
                            <MenuItem
                                x:Name="OverlayOpacityOffMenuItem"
                                Click="OverlayOpacityMenuItem_Click"
                                Header="關閉"
                                IsCheckable="True"
                                Tag="0" />
                            <MenuItem
                                x:Name="OverlayOpacityLowMenuItem"
                                Click="OverlayOpacityMenuItem_Click"
                                Header="5%"
                                IsCheckable="True"
                                IsChecked="True"
                                Tag="0.05" />
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            x:Name="CloseOnGrabMenuItem"
                            Click="CloseOnGrabMenuItem_Click"
                            Header="擷取時關閉擷取框"
                            IsCheckable="True" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem
                            x:Name="ContactMenuItem"
                            Click="ContactMenuItem_Click"
                            Header="聯絡開發者..." />
                        <MenuItem
                            x:Name="RateAndReview"
                            Click="RateAndReview_Click"
                            Header="評分與評論..." />
                        <MenuItem
                            x:Name="FeedbackMenuItem"
                            Click="FeedbackMenuItem_Click"
                            Header="_Feedback..." />
                        <MenuItem
                            x:Name="AboutMenuItem"
                            Click="AboutMenuItem_Click"
                            Header="_About" />
                    </MenuItem>
                </Menu>
                <StackPanel
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                    ClipToBounds="True"
                    Orientation="Horizontal">
                    <Image
                        x:Name="WindowIcon"
                        Width="20"
                        Height="20"
                        Margin="4,2,4,4"
                        Source="{StaticResource TextGrabIcon}"
                        Stretch="UniformToFill">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock
                        Margin="4,-4,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="擷取框">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ui:TitleBar
                    Grid.ColumnSpan="3"
                    Width="200"
                    Height="32"
                    Margin="2,2,2,0"
                    Padding="8,2"
                    HorizontalAlignment="Right"
                    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <Button
                        x:Name="MinimizeButton"
                        Width="46"
                        Height="32"
                        Margin="0,-2,0,0"
                        AutomationProperties.AutomationId="GrabFrame.MinimizeButton"
                        AutomationProperties.Name="最小化"
                        Click="OnMinimizeButtonClick"
                        Style="{StaticResource TitleBarButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" />
                    </Button>
                    <Button
                        x:Name="RestoreButton"
                        Width="46"
                        Height="32"
                        Margin="0,-2,0,0"
                        AutomationProperties.AutomationId="GrabFrame.RestoreButton"
                        AutomationProperties.Name="還原"
                        Click="OnRestoreButtonClick"
                        Style="{StaticResource TitleBarButtonStyle}">
                        <TextBlock
                            x:Name="RestoreTextlock"
                            FontFamily="Segoe MDL2 Assets"
                            Text="" />
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Width="46"
                        Height="32"
                        Margin="0,-2,0,0"
                        AutomationProperties.AutomationId="GrabFrame.CloseButton"
                        AutomationProperties.Name="關閉"
                        Click="OnCloseButtonClick"
                        Style="{StaticResource TitleBarCloseButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" />
                    </Button>

                </StackPanel>
            </Grid>
            <Border
                x:Name="RectanglesBorder"
                Grid.Row="1"
                AutomationProperties.AutomationId="GrabFrame.Content"
                ClipToBounds="True">
                <Border.Background>
                    <SolidColorBrush Opacity=".05" Color="White" />
                </Border.Background>
                <Grid>
                    <controls:ZoomBorder
                        x:Name="MainZoomBorder"
                        AutomationProperties.AutomationId="GrabFrame.ZoomSurface"
                        AutomationProperties.Name="擷取影像縮放與平移區域">
                        <Viewbox Name="CanvasViewBox">
                            <Grid>
                                <Image
                                    x:Name="GrabFrameImage"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="GrabFrame.Image"
                                    Opacity="0"
                                    Stretch="Uniform" />
                                <Canvas
                                    x:Name="PdfTextCanvas"
                                    Margin="0"
                                    AutomationProperties.AutomationId="GrabFrame.PdfTextCanvas"
                                    AutomationProperties.Name="PDF 文字覆疊"
                                    ClipToBounds="True"
                                    ContextMenu="{Binding ContextMenu, ElementName=RectanglesCanvas}"
                                    MouseDown="RectanglesCanvas_MouseDown"
                                    MouseMove="RectanglesCanvas_MouseMove"
                                    MouseUp="RectanglesCanvas_MouseUp" />
                                <Canvas
                                    x:Name="RectanglesCanvas"
                                    Margin="0"
                                    AutomationProperties.AutomationId="GrabFrame.WordBordersCanvas"
                                    AutomationProperties.Name="辨識文字邊界"
                                    Background="Transparent"
                                    Focusable="True"
                                    IsHitTestVisible="True"
                                    MouseDown="RectanglesCanvas_MouseDown"
                                    MouseMove="RectanglesCanvas_MouseMove"
                                    MouseUp="RectanglesCanvas_MouseUp">
                                    <Canvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{x:Static local:GrabFrame.PasteCommand}"
                                                Header="貼上圖片"
                                                InputGestureText="Ctrl + Shift + V" />
                                            <MenuItem
                                                Click="OpenImageMenuItem_Click"
                                                Header="開啟圖片或 PDF..."
                                                InputGestureText="Ctrl + O" />
                                            <MenuItem Click="CaptureFromCameraMenuItem_Click" Header="從相機擷取..." />
                                            <Separator />
                                            <MenuItem
                                                x:Name="CopyText"
                                                Click="CopyText_Click"
                                                Header="複製文字" />
                                            <Separator />
                                            <MenuItem
                                                x:Name="AspectRationMI"
                                                Checked="AspectRationMI_Checked"
                                                Header="維持長寬比"
                                                IsCheckable="True"
                                                IsChecked="True"
                                                Unchecked="AspectRationMI_Checked" />
                                            <MenuItem
                                                x:Name="FreezeMI"
                                                Click="FreezeMI_Click"
                                                Header="切換凍結"
                                                InputGestureText="F" />
                                            <Separator />
                                            <MenuItem
                                                x:Name="TryToNumberMenuItem"
                                                Click="TryToNumberMenuItem_Click"
                                                Header="嘗試轉換為數字" />
                                            <MenuItem
                                                x:Name="TryToAlphaMenuItem"
                                                Click="TryToAlphaMenuItem_Click"
                                                Header="嘗試轉換為字母" />
                                            <MenuItem
                                                Command="{x:Static local:GrabFrame.MergeWordsCommand}"
                                                Header="合併文字邊界"
                                                InputGestureText="Ctrl + M" />
                                            <MenuItem
                                                Command="{x:Static local:GrabFrame.DeleteWordsCommand}"
                                                Header="刪除選取文字"
                                                InputGestureText="Del" />
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                </Canvas>
                                <Canvas
                                    x:Name="TemplateRegionOverlayCanvas"
                                    Margin="-4,-2,0,0"
                                    Panel.ZIndex="5"
                                    AutomationProperties.AutomationId="GrabFrame.TemplateRegions"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False" />
                                <Canvas
                                    x:Name="TablePlacementOverlayCanvas"
                                    Margin="0"
                                    Panel.ZIndex="6"
                                    AutomationProperties.AutomationId="GrabFrame.TablePlacementSurface"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </Viewbox>
                    </controls:ZoomBorder>
                    <Border
                        x:Name="TablePlacementBanner"
                        Margin="16"
                        Padding="12,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="GrabFrame.TablePlacementStatus"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.35"
                                ShadowDepth="3"
                                Color="Black" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="TablePlacementInstructionsTextBlock"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Text="按一下以放置表格分隔線。" />
                            <Button
                                x:Name="CancelTablePlacementButton"
                                MinWidth="72"
                                AutomationProperties.AutomationId="GrabFrame.CancelTablePlacementButton"
                                Click="CancelTablePlacement_Click"
                                Content="取消" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="TranslationProgressBorder"
                        Height="40"
                        Margin="8"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="GrabFrame.TranslationProgress"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="270"
                                Opacity="0.3"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                Symbol="LocalLanguage24" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    x:Name="TranslationProgressText"
                                    Margin="0,0,0,2"
                                    AutomationProperties.AutomationId="GrabFrame.TranslationProgressText"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="翻譯中…" />
                                <ProgressBar
                                    x:Name="TranslationProgressBar"
                                    Height="6"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="0" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TranslationCountText"
                                Grid.Column="2"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="0/0" />
                            <Button
                                x:Name="CancelTranslationButton"
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="GrabFrame.CancelTranslationButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CancelTranslationButton_Click"
                                ToolTip="取消翻譯">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Symbol="Dismiss24" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="SpeakingProgressBorder"
                        Height="40"
                        Margin="8"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="GrabFrame.SpeakingStatus"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="270"
                                Opacity="0.3"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Speaker224" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,2"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="朗讀中…" />
                                <ProgressBar Height="6" IsIndeterminate="True" />
                            </StackPanel>
                            <Button
                                x:Name="StopSpeakingButton"
                                Grid.Column="2"
                                Width="28"
                                Height="28"
                                Margin="12,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="GrabFrame.StopSpeakingButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="StopSpeakingButton_Click"
                                ToolTip="停止朗讀">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Symbol="Stop24" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="FrameMessageBorder"
                        MaxWidth="420"
                        Margin="16,16,16,20"
                        Padding="12,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="GrabFrame.Status"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.35"
                                ShadowDepth="3"
                                Color="Black" />
                        </Border.Effect>
                        <TextBlock
                            x:Name="FrameMessageTextBlock"
                            AutomationProperties.AutomationId="GrabFrame.StatusText"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
            <!--  Template Save Panel (collapsed by default, shown when Save as Template is toggled)  -->
            <Border
                x:Name="TemplateSavePanel"
                Grid.Row="2"
                AutomationProperties.AutomationId="GrabFrame.TemplateSavePanel"
                Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="範本名稱：" />
                    <TextBox
                        x:Name="TemplateNameBox"
                        Grid.Column="1"
                        Padding="4,2"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="GrabFrame.TemplateName" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,6,0"
                        VerticalAlignment="Center"
                        Text="輸出（輸入 { 以選取）："
                        ToolTip="輸入 { 可插入區域標記，也支援純文字。" />
                    <controls:InlinePickerRichTextBox
                        x:Name="TemplateOutputBox"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        AutomationProperties.AutomationId="GrabFrame.TemplateOutput"
                        TextChanged="TemplateOutputBox_TextChanged"
                        ToolTip="輸入 { 可開啟區域選擇器，也支援純文字。" />
                    <Button
                        Grid.Column="4"
                        Margin="8,0,4,0"
                        Padding="8,4"
                        Click="SaveTemplateSave_Click"
                        Content="儲存範本" />
                    <Button
                        Grid.Column="5"
                        Padding="8,4"
                        Click="SaveTemplateCancel_Click"
                        Content="取消" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="顯示工具列按鈕" IsEnabled="False" />
                        <Separator />
                        <MenuItem
                            x:Name="ShowRefreshToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="重新執行 OCR／辨識擷取框"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Refresh" />
                        <MenuItem
                            x:Name="ShowFreezeToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="凍結"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Freeze" />
                        <MenuItem
                            x:Name="ShowTableToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="分析為表格"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Table" />
                        <MenuItem
                            x:Name="ShowTranslateToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="翻譯"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Translate" />
                        <MenuItem
                            x:Name="ShowSpeakToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="朗讀"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Speak" />
                        <MenuItem
                            x:Name="ShowEditTextToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="文字編輯視窗"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="EditText" />
                        <MenuItem
                            x:Name="ShowTemplateToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="擷取範本"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Template" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid
                    MinHeight="36"
                    Margin="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchBar
                        x:Name="SearchBar"
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="GrabFrame.Search"
                        PlaceholderText="搜尋文字..."
                        SearchChanged="SearchBar_SearchChanged"
                        ShowExactMatchToggle="True" />

                    <Menu
                        x:Name="MatchesMenu"
                        Grid.Column="2"
                        Height="28"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        ClipToBounds="True"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Visibility="Collapsed">
                        <MenuItem>
                            <MenuItem.Header>
                                <TextBlock
                                    x:Name="MatchesTXTBLK"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="GrabFrame.SearchMatchCount"
                                    Text="Matches: 0" />
                            </MenuItem.Header>
                            <MenuItem Click="HandleDelete" Header="刪除選取項目" />
                            <Separator />
                            <MenuItem
                                Name="EditMatchesMenuItem"
                                Click="EditMatchesMenuItem_Click"
                                Header="在新視窗編輯比對結果" />
                        </MenuItem>
                    </Menu>

                    <ComboBox
                        x:Name="LanguagesComboBox"
                        Grid.Column="3"
                        MinWidth="60"
                        Padding="8,0"
                        AutomationProperties.AutomationId="GrabFrame.Language"
                        AutomationProperties.Name="OCR 語言"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        PreviewMouseDown="LanguagesComboBox_MouseDown"
                        SelectionChanged="LanguagesComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    Style="{StaticResource SymbolTextStyle}"
                                    Text="{Binding LanguageTag}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel
                        x:Name="ButtonsStackPanel"
                        Grid.Column="4"
                        Margin="6,0"
                        Orientation="Horizontal">
                        <StackPanel
                            x:Name="PdfPagePanel"
                            Margin="0,0,6,0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <Button
                                x:Name="PreviousPdfPageButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                AutomationProperties.AutomationId="GrabFrame.PreviousPageButton"
                                AutomationProperties.Name="上一頁 PDF"
                                Click="PreviousPdfPageButton_Click"
                                ToolTip="上一頁 PDF">
                                <ui:SymbolIcon Symbol="ChevronLeft24" />
                            </Button>
                            <TextBlock
                                x:Name="PdfPageTextBlock"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="GrabFrame.PageStatus"
                                Text="Page 1 / 1" />
                            <Button
                                x:Name="NextPdfPageButton"
                                Width="30"
                                Height="30"
                                Margin="6,0,0,0"
                                Padding="0"
                                AutomationProperties.AutomationId="GrabFrame.NextPageButton"
                                AutomationProperties.Name="下一頁 PDF"
                                Click="NextPdfPageButton_Click"
                                ToolTip="下一頁 PDF">
                                <ui:SymbolIcon Symbol="ChevronRight24" />
                            </Button>
                        </StackPanel>
                        <controls:CollapsibleButton
                            x:Name="RefreshBTN"
                            Width="30"
                            Height="30"
                            Margin="0"
                            AutomationProperties.AutomationId="GrabFrame.RefreshButton"
                            AutomationProperties.Name="重新整理 OCR 結果"
                            ButtonSymbol="ArrowClockwise24"
                            ButtonText="重新辨識擷取框"
                            Click="RefreshBTN_Click"
                            IsSymbol="True"
                            ToolTip="重新辨識擷取框 (Ctrl + R)" />
                        <controls:CollapsibleButton
                            x:Name="OcrFrameBTN"
                            Margin="0"
                            AutomationProperties.AutomationId="GrabFrame.OcrButton"
                            AutomationProperties.Name="執行 OCR"
                            ButtonSymbol="ScanText24"
                            ButtonText="辨識擷取框"
                            Click="RefreshBTN_Click"
                            ToolTip="辨識擷取框 (Ctrl + R)"
                            Visibility="Collapsed" />

                        <ToggleButton
                            x:Name="FreezeToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="GrabFrame.FreezeToggle"
                            AutomationProperties.Name="凍結框內圖片"
                            Click="FreezeToggleButton_Click"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(F) 凍結擷取框中的內容">
                            <ui:SymbolIcon Symbol="Pause24" />
                        </ToggleButton>

                        <ToggleButton
                            x:Name="TableToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="GrabFrame.TableToggle"
                            AutomationProperties.Name="分析為表格"
                            Click="TableToggleButton_Click"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(T) 將內容分析為表格">
                            <ToggleButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        x:Name="TableToggleAddRowMenuItem"
                                        Click="AddTableRowMenuItem_Click"
                                        Header="新增資料列" />
                                    <MenuItem
                                        x:Name="TableToggleAddColumnMenuItem"
                                        Click="AddTableColumnMenuItem_Click"
                                        Header="新增欄" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="TableToggleCancelPlacementMenuItem"
                                        Click="CancelTablePlacement_Click"
                                        Header="取消放置" />
                                </ContextMenu>
                            </ToggleButton.ContextMenu>
                            <ui:SymbolIcon Symbol="Table24" />
                        </ToggleButton>

                        <ToggleButton
                            x:Name="TranslateToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="GrabFrame.TranslateToggle"
                            AutomationProperties.Name="啟用翻譯"
                            Click="TranslateToggleButton_Click"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="啟用即時翻譯">
                            <ui:SymbolIcon Symbol="LocalLanguage24" />
                        </ToggleButton>

                        <ToggleButton
                            x:Name="SpeakToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="GrabFrame.SpeakToggle"
                            AutomationProperties.Name="朗讀結果"
                            Click="SpeakToggleButton_Click"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="朗讀擷取的文字">
                            <ui:SymbolIcon Symbol="Speaker224" />
                        </ToggleButton>

                        <ToggleButton
                            x:Name="EditToggleButton"
                            Margin="6,0,0,0"
                            Padding="7,4"
                            AutomationProperties.AutomationId="GrabFrame.EditWordsToggle"
                            AutomationProperties.Name="編輯辨識出的文字"
                            Click="EditToggleButton_Click"
                            IsChecked="True"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="編輯擷取框中的個別文字"
                            Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe MDL2 Assets">
                                
                            </TextBlock>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="EditTextToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            d:IsChecked="True"
                            AutomationProperties.AutomationId="GrabFrame.SendToEditTextToggle"
                            AutomationProperties.Name="將結果傳送至文字編輯視窗"
                            Click="EditTextBTN_Click"
                            IsChecked="False"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(E) 編輯擷取框中的個別文字">
                            <ui:SymbolIcon Symbol="Window24" />
                        </ToggleButton>

                        <controls:CollapsibleButton
                            x:Name="SettingsBTN"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="GrabFrame.SettingsButton"
                            AutomationProperties.Name="設定"
                            ButtonSymbol="Settings24"
                            ButtonText="設定"
                            Click="SettingsBTN_Click"
                            IsSymbol="True"
                            ToolTip="開啟 Text Grab 設定"
                            Visibility="Collapsed" />

                        <ui:DropDownButton
                            x:Name="TemplateMenuButton"
                            Width="50"
                            Height="30"
                            Margin="6,0,0,0"
                            Padding="0"
                            ToolTip="選取或建立擷取範本">
                            <ui:DropDownButton.Content>
                                <ui:SymbolIcon Symbol="DocumentSave24" />
                            </ui:DropDownButton.Content>
                            <ui:DropDownButton.Flyout>
                                <ContextMenu x:Name="TemplateContextMenu" Opened="TemplateContextMenu_Opened" />
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </StackPanel>

                    <controls:CollapsibleButton
                        x:Name="GrabBTN"
                        Grid.Column="5"
                        Width="110"
                        Margin="0"
                        AutomationProperties.AutomationId="GrabFrame.GrabButton"
                        ButtonSymbol="Copy24"
                        ButtonText="擷取"
                        Command="{x:Static local:GrabFrame.GrabCommand}"
                        ToolTip="擷取擷取框中的文字">
                        <controls:CollapsibleButton.ContextMenu>
                            <ContextMenu Opened="GrabButtonContextMenu_Opened">
                                <MenuItem
                                    AutomationProperties.AutomationId="GrabFrame.GrabMultiplePagesMenuItem"
                                    Click="GrabMultiplePagesMenuItem_Click"
                                    Header="擷取多個頁面..."
                                    Tag="GrabMultiplePages"
                                    ToolTip="將目前的區域與表格設定套用至開啟中 PDF 的多個頁面" />
                                <MenuItem
                                    AutomationProperties.AutomationId="GrabFrame.IgnoreRepeatedHeadersFootersMenuItem"
                                    Click="IgnoreRepeatedHeadersFootersMenuItem_Click"
                                    Header="忽略重複的頁首與頁尾"
                                    IsCheckable="True"
                                    Tag="IgnoreRepeatedHeadersFooters"
                                    ToolTip="擷取多個頁面時，略過每頁相同位置出現的相同（或編號）文字，例如通用頁首與頁碼" />
                            </ContextMenu>
                        </controls:CollapsibleButton.ContextMenu>
                    </controls:CollapsibleButton>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
