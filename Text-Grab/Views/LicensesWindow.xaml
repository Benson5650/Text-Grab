<ui:FluentWindow
    x:Class="Text_Grab.Views.LicensesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="第三方授權"
    Width="1200"
    Height="760"
    MinWidth="900"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />
    </Window.Resources>

    <Grid Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="第三方授權"
            Height="32"
            Margin="2,2,2,0"
            Padding="8,2"
            Icon="{StaticResource TextGrabIcon}" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="14,12,14,8">
                <TextBlock Style="{StaticResource TextHeader}" Text="直接相依套件與授權聲明" />
                <TextBlock
                    Margin="0,8,0,12"
                    Style="{StaticResource TextBodyNormal}"
                    TextWrapping="Wrap">
                    本頁列出 Text Grab 應用程式與測試專案使用的直接 NuGet 套件參照。常見的寬鬆授權會開啟上游儲存庫的授權檔；若 NuGet 套件附有自己的授權文字，則會在本機提供該套件專屬的 Microsoft 條款。
                </TextBlock>

                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,12,0"
                        Click="BuiltWithButton_Click"
                        Content="開啟 BUILT-WITH.md"
                        Icon="{ui:SymbolIcon DocumentText24}" />
                    <ui:Button
                        Click="NoticesFolderButton_Click"
                        Content="開啟第三方聲明資料夾"
                        Icon="{ui:SymbolIcon Folder24}" />
                </StackPanel>

                <Border Background="{ui:ThemeResource SolidBackgroundFillColorBaseAltBrush}" CornerRadius="8">
                    <DataGrid
                        x:Name="LicensesDataGrid"
                        AlternatingRowBackground="{DynamicResource ApplicationBackgroundBrush}"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CellStyle="{DynamicResource DataGridCellStyleDark}"
                        ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyleDark}"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        ItemsSource="{Binding Packages}"
                        RowBackground="Transparent"
                        RowStyle="{DynamicResource DataGridRowStyleDark}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="2.4*"
                                Binding="{Binding PackageId}"
                                Header="套件" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Version}"
                                Header="版本" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Scope}"
                                Header="範圍" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding License}"
                                Header="授權條款" />
                            <DataGridTemplateColumn Width="Auto" Header="告知事項">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button
                                            MinWidth="90"
                                            Padding="10,4"
                                            Click="NoticeButton_Click"
                                            Content="開啟" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" Header="專案">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button
                                            MinWidth="90"
                                            Padding="10,4"
                                            Click="ProjectButton_Click"
                                            Content="開啟" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="2.5*" Header="備註">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="4,0"
                                            Text="{Binding DisplayNotes}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="2"
            Margin="16,0,16,12"
            HorizontalAlignment="Right"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Style="{StaticResource TextBodyNormal}"
            Text="目前應用程式與測試直接參照 26 個 NuGet 套件。" />
    </Grid>
</ui:FluentWindow>
