<ui:FluentWindow
    x:Class="Text_Grab.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="歡迎使用 Text Grab"
    AutomationProperties.AutomationId="FirstRunWindow"
    Width="1120"
    Height="820"
    MinWidth="760"
    MinHeight="620"
    Padding="0"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Closed="Window_Closed"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="FirstRun_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />

        <SolidColorBrush x:Key="WelcomeAccentFillBrush" Color="#18308E98" />
        <SolidColorBrush x:Key="WelcomeAccentFillStrongBrush" Color="#24308E98" />
        <SolidColorBrush x:Key="WelcomeCardBorderBrush" Color="#33308E98" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WelcomeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style
            x:Key="ModeCard"
            BasedOn="{StaticResource SurfaceCard}"
            TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WelcomeAccentFillStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WelcomeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="14,7" />
        </Style>

        <Style x:Key="WelcomeSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseAltBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource WelcomeCardBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WelcomeAccentFillBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Teal}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="ModePreviewButton"
            BasedOn="{StaticResource WelcomeSecondaryButton}"
            TargetType="Button">
            <Setter Property="Width" Value="200" />
        </Style>

        <Style x:Key="HeroStatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WelcomeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="歡迎使用 Text Grab"
            Height="36"
            Margin="2,2,2,0"
            Padding="10,2"
            Icon="{StaticResource TextGrabIcon}" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1180" Margin="32,24,32,32">
                <StackPanel>
                    <Border Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,24,0">
                                <TextBlock
                                    FontSize="40"
                                    FontWeight="SemiBold"
                                    Text="歡迎使用 Text Grab"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,14,0,0"
                                    FontSize="17"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="從螢幕任何位置擷取文字，依情境啟動適合的模式，並依照你的習慣讓應用程式隨時待命。"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,22,0,0"
                                    FontSize="15"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="選擇預設模式、實際體驗各種功能，並調整啟動選項，讓 Text Grab 融入 Windows 使用流程。"
                                    TextWrapping="Wrap" />

                                <StackPanel Margin="0,28,0,0" Orientation="Horizontal">
                                    <Button
                                        x:Name="OkayButton"
                                        AutomationProperties.AutomationId="FirstRun.StartButton"
                                        Width="220"
                                        Click="OkayButton_Click"
                                        Style="{StaticResource TealColor}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,8,0" Symbol="Play24" />
                                            <TextBlock Foreground="White" Text="以選取的模式開始" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="SettingsButton"
                                        AutomationProperties.AutomationId="FirstRun.OpenSettingsButton"
                                        Width="160"
                                        Margin="12,0,0,0"
                                        Click="SettingsButton_Click"
                                        Style="{StaticResource WelcomeSecondaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,8,0" Symbol="Settings24" />
                                            <TextBlock Text="開啟設定" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <UniformGrid Margin="0,28,0,0" Columns="3">
                                    <Border Style="{StaticResource HeroStatCard}">
                                        <StackPanel>
                                            <ui:SymbolIcon FontSize="20" Symbol="AppsList24" />
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="四種專注模式" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource CardBody}"
                                                Text="選擇一種預設模式，也能隨時快速切換至其他模式。" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource HeroStatCard}">
                                        <StackPanel>
                                            <ui:SymbolIcon FontSize="20" Symbol="Clipboard24" />
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="以剪貼簿為核心" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource CardBody}"
                                                Text="快速擷取並貼上文字，只在需要時開啟編輯工具。" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0" Style="{StaticResource HeroStatCard}">
                                        <StackPanel>
                                            <ui:SymbolIcon FontSize="20" Symbol="ShieldTask24" />
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="以隱私為優先" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource CardBody}"
                                                Text="使用 Windows 內建的 OCR 引擎，讓擷取的文字留在本機。" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Padding="22"
                                Background="{StaticResource WelcomeAccentFillBrush}"
                                BorderBrush="{StaticResource WelcomeCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                                <StackPanel>
                                    <Border
                                        Width="82"
                                        Height="82"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource WelcomeAccentFillStrongBrush}"
                                        CornerRadius="24">
                                        <Image
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="/Text-Grab;component/Images/TealSelect40.png" />
                                    </Border>

                                    <TextBlock
                                        Margin="0,18,0,0"
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Text="一分鐘快速上手" />

                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Style="{StaticResource SectionBody}"
                                        Text="先從一種模式開始，再逐步探索其他功能。" />

                                    <Border
                                        Margin="0,18,0,0"
                                        Padding="14"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{StaticResource WelcomeCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="1. 選擇預設啟動模式" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource CardBody}"
                                                Text="全螢幕擷取、擷取框、文字編輯或快速查詢。" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Margin="0,12,0,0"
                                        Padding="14"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{StaticResource WelcomeCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="2. 實際體驗各種模式" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource CardBody}"
                                                Text="下方每張預覽卡片都能立即啟動對應模式。" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Margin="0,12,0,0"
                                        Padding="14"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{StaticResource WelcomeCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="3. 讓應用程式隨時待命" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{StaticResource CardBody}"
                                                Text="可依照你的工作流程啟用通知、背景執行與開機啟動。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        Height="1"
                        Margin="0,26,0,6"
                        Background="{StaticResource WelcomeCardBorderBrush}"
                        Opacity="0.8" />

                    <StackPanel Margin="0,22,0,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="選擇預設啟動模式" />
                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource SectionBody}"
                            Text="每種模式都適合不同的文字處理情境。先選擇最常使用的模式，也能隨時體驗其他模式。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <UniformGrid Margin="0,22,0,0" Columns="2">
                        <Border Style="{StaticResource ModeCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,2,10,0"
                                            FontSize="22"
                                            Symbol="SlideAdd20" />
                                        <TextBlock Style="{StaticResource CardTitle}" Text="全螢幕擷取" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Style="{StaticResource CardBody}"
                                        Text="就像專為文字設計的截圖工具。框選後即可快速複製，並將結果直接送到剪貼簿。" />
                                </StackPanel>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,18,0,0"
                                    Padding="10"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Image
                                        Height="190"
                                        Source="/Text-Grab;component/Images/FSG.png"
                                        Stretch="UniformToFill" />
                                </Border>

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource CardBody}"
                                    Text="適合快速擷取螢幕上的單段文字。" />

                                <Button
                                    x:Name="TryFullscreen"
                                    AutomationProperties.AutomationId="FirstRun.PreviewFullscreenButton"
                                    Grid.Row="3"
                                    Margin="0,18,0,0"
                                    Click="TryFullscreen_Click"
                                    Style="{StaticResource ModePreviewButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Play24" />
                                        <TextBlock Text="立即試用" />
                                    </StackPanel>
                                </Button>

                                <RadioButton
                                    x:Name="FullScreenRDBTN"
                                    AutomationProperties.AutomationId="FirstRun.DefaultFullscreenRadio"
                                    Grid.Row="4"
                                    Margin="0,18,0,0"
                                    Checked="RadioButton_Checked"
                                    GroupName="DefaultLaunch">
                                    <TextBlock Style="{StaticResource CardBody}" Text="將全螢幕擷取設為預設啟動模式" />
                                </RadioButton>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModeCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,2,10,0"
                                            FontSize="22"
                                            Symbol="PanelBottom20" />
                                        <TextBlock Style="{StaticResource CardTitle}" Text="擷取框" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Style="{StaticResource CardBody}"
                                        Text="讓 OCR 擷取框保持在最上層，就地檢視文字，並在應用程式中處理圖片或 PDF。" />
                                </StackPanel>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,18,0,0"
                                    Padding="10"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Image
                                        Height="190"
                                        Source="/Text-Grab;component/Images/GF.png"
                                        Stretch="UniformToFill" />
                                </Border>

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource CardBody}"
                                    Text="適合重複擷取、畫面覆疊、PDF 與需要精細控制的情境。" />

                                <Button
                                    x:Name="TryGrabFrame"
                                    AutomationProperties.AutomationId="FirstRun.PreviewGrabFrameButton"
                                    Grid.Row="3"
                                    Margin="0,18,0,0"
                                    Click="TryGrabFrame_Click"
                                    Style="{StaticResource ModePreviewButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Play24" />
                                        <TextBlock Text="顯示擷取框" />
                                    </StackPanel>
                                </Button>

                                <RadioButton
                                    x:Name="GrabFrameRDBTN"
                                    AutomationProperties.AutomationId="FirstRun.DefaultGrabFrameRadio"
                                    Grid.Row="4"
                                    Margin="0,18,0,0"
                                    Checked="RadioButton_Checked"
                                    GroupName="DefaultLaunch">
                                    <TextBlock Style="{StaticResource CardBody}" Text="將擷取框設為預設啟動模式" />
                                </RadioButton>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModeCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,2,10,0"
                                            FontSize="22"
                                            Symbol="Window20" />
                                        <TextBlock Style="{StaticResource CardTitle}" Text="文字編輯視窗" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Style="{StaticResource CardBody}"
                                        Text="在專注的純文字工作區整理 OCR 結果，使用大小寫、修剪、規則運算式與快速校正等工具。" />
                                </StackPanel>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,18,0,0"
                                    Padding="10"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Image
                                        Height="190"
                                        Source="/Text-Grab;component/Images/ETW.png"
                                        Stretch="UniformToFill" />
                                </Border>

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource CardBody}"
                                    Text="適合想在同一處完成 OCR 與簡易文字整理的情境。" />

                                <Button
                                    x:Name="TryEditWindow"
                                    AutomationProperties.AutomationId="FirstRun.PreviewEditTextButton"
                                    Grid.Row="3"
                                    Margin="0,18,0,0"
                                    Click="TryEditWindow_Click"
                                    Style="{StaticResource ModePreviewButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Play24" />
                                        <TextBlock Text="開啟文字編輯視窗" />
                                    </StackPanel>
                                </Button>

                                <RadioButton
                                    x:Name="EditWindowRDBTN"
                                    AutomationProperties.AutomationId="FirstRun.DefaultEditTextRadio"
                                    Grid.Row="4"
                                    Margin="0,18,0,0"
                                    Checked="RadioButton_Checked"
                                    GroupName="DefaultLaunch">
                                    <TextBlock Style="{StaticResource CardBody}" Text="將文字編輯視窗設為預設啟動模式" />
                                </RadioButton>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModeCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Margin="0,2,10,0"
                                            FontSize="22"
                                            Symbol="SlideSearch20" />
                                        <TextBlock Style="{StaticResource CardTitle}" Text="快速查詢" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Style="{StaticResource CardBody}"
                                        Text="儲存可重複使用的文字片段，即時搜尋並複製所需文字，不必再次執行 OCR。" />
                                </StackPanel>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,18,0,0"
                                    Padding="10"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <Image
                                        Height="190"
                                        Source="/Text-Grab;component/Images/QSL.png"
                                        Stretch="UniformToFill" />
                                </Border>

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource CardBody}"
                                    Text="適合管理個人文字庫、範本，以及快速複製貼上的工作流程。" />

                                <Button
                                    x:Name="TryQuickLookup"
                                    AutomationProperties.AutomationId="FirstRun.PreviewQuickLookupButton"
                                    Grid.Row="3"
                                    Margin="0,18,0,0"
                                    Click="TryQuickLookup_Click"
                                    Style="{StaticResource ModePreviewButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Play24" />
                                        <TextBlock Text="啟動快速查詢" />
                                    </StackPanel>
                                </Button>

                                <RadioButton
                                    x:Name="QuickLookupRDBTN"
                                    AutomationProperties.AutomationId="FirstRun.DefaultQuickLookupRadio"
                                    Grid.Row="4"
                                    Margin="0,18,0,0"
                                    Checked="RadioButton_Checked"
                                    GroupName="DefaultLaunch">
                                    <TextBlock Style="{StaticResource CardBody}" Text="將快速查詢設為預設啟動模式" />
                                </RadioButton>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="設定啟動後的使用體驗" />
                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource SectionBody}"
                            Text="這些快速選項涵蓋最常調整的設定。其他選項仍可在完整的設定視窗中使用。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <UniformGrid Margin="0,22,0,0" Columns="3">
                        <Border Style="{StaticResource ModeCard}">
                            <StackPanel>
                                <ui:SymbolIcon FontSize="24" Symbol="Alert24" />
                                <TextBlock
                                    Margin="0,14,0,0"
                                    Style="{StaticResource CardTitle}"
                                    Text="通知" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Style="{StaticResource CardBody}"
                                    Text="直接從通知開啟文字編輯視窗，查看已複製的文字。" />
                                <ui:ToggleSwitch
                                    x:Name="NotificationsCheckBox"
                                    AutomationProperties.AutomationId="FirstRun.NotificationsToggle"
                                    Margin="0,20,0,0"
                                    Checked="NotificationsCheckBox_Checked"
                                    Unchecked="NotificationsCheckBox_Checked">
                                    <TextBlock Style="{StaticResource CardBody}" Text="啟用通知" />
                                </ui:ToggleSwitch>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModeCard}">
                            <StackPanel>
                                <ui:SymbolIcon FontSize="24" Symbol="WindowConsole20" />
                                <TextBlock
                                    Margin="0,14,0,0"
                                    Style="{StaticResource CardTitle}"
                                    Text="背景執行" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Style="{StaticResource CardBody}"
                                    Text="讓 Text Grab 在背景執行，以便隨時使用快捷鍵並快速重新啟動。" />
                                <ui:ToggleSwitch x:Name="BackgroundCheckBox" AutomationProperties.AutomationId="FirstRun.BackgroundToggle" Margin="0,20,0,0">
                                    <TextBlock Style="{StaticResource CardBody}" Text="在背景執行 Text Grab" />
                                </ui:ToggleSwitch>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModeCard}">
                            <StackPanel>
                                <ui:SymbolIcon FontSize="24" Symbol="ArrowAutofitUp24" />
                                <TextBlock
                                    Margin="0,14,0,0"
                                    Style="{StaticResource CardTitle}"
                                    Text="啟動" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Style="{StaticResource CardBody}"
                                    Text="Windows 啟動時一併啟動 Text Grab，讓偏好的模式隨時可用。" />
                                <ui:ToggleSwitch
                                    x:Name="StartupCheckbox"
                                    AutomationProperties.AutomationId="FirstRun.StartupToggle"
                                    Margin="0,20,0,0"
                                    Checked="StartupCheckbox_Checked"
                                    Unchecked="StartupCheckbox_Checked">
                                    <TextBlock
                                        x:Name="StartupTextblock"
                                        AutomationProperties.AutomationId="FirstRun.StartupStatus"
                                        Style="{StaticResource CardBody}"
                                        Text="開機時啟動 Text Grab" />
                                </ui:ToggleSwitch>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            Style="{StaticResource SurfaceCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Text Grab 的特色" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    Style="{StaticResource SectionBody}"
                                    Text="Text Grab 著重速度、實用性與隱私，讓 OCR 流程保持簡潔。"
                                    TextWrapping="Wrap" />

                                <Border
                                    Margin="0,18,0,0"
                                    Padding="16"
                                    Background="{StaticResource WelcomeAccentFillBrush}"
                                    BorderBrush="{StaticResource WelcomeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="快速好用" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource CardBody}"
                                            Text="擷取文字並送到剪貼簿，透過簡潔介面快速完成工作。" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="0,12,0,0"
                                    Padding="16"
                                    Background="{StaticResource WelcomeAccentFillBrush}"
                                    BorderBrush="{StaticResource WelcomeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="重視隱私" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource CardBody}"
                                            Text="使用 Windows 內建的 OCR 引擎，不會將擷取的文字傳送到裝置以外。" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="0,12,0,0"
                                    Padding="16"
                                    Background="{StaticResource WelcomeAccentFillBrush}"
                                    BorderBrush="{StaticResource WelcomeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="融入 Windows" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource CardBody}"
                                            Text="跳躍清單、剪貼簿管理員、開機啟動與背景快捷鍵協同運作，帶來原生的 Windows 體驗。" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,20,0,0" Style="{StaticResource CardBody}">
                                    需要協助、提供意見回饋，或想看看最新資訊嗎？<LineBreak />
                                    <LineBreak />
                                    <Hyperlink
                                        Foreground="DeepSkyBlue"
                                        NavigateUri="https://github.com/TheJoeFin/Text-Grab/"
                                        RequestNavigate="Hyperlink_RequestNavigate">
                                        前往 GitHub 專案
                                    </Hyperlink>
                                    <LineBreak />
                                    <Hyperlink
                                        Foreground="DeepSkyBlue"
                                        NavigateUri="mailto:support@textgrab.net"
                                        RequestNavigate="Hyperlink_RequestNavigate">
                                        寄信至 support@TextGrab.net
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Style="{StaticResource SurfaceCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="想進一步了解？" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    Style="{StaticResource SectionBody}"
                                    Text="常用功能一目了然；想深入了解時，也能在此瀏覽其他說明。"
                                    TextWrapping="Wrap" />

                                <Expander Margin="0,18,0,0" Header="全螢幕擷取的運作方式">
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource CardBody}">
                                        框選要擷取的文字，或按一下單一文字。Text Grab 會使用 Windows OCR 讀取選取範圍，將結果複製到剪貼簿，讓你貼到任何位置。若未辨識到內容，可立即再試一次。
                                    </TextBlock>
                                </Expander>

                                <Expander Margin="0,12,0,0" Header="擷取框的運作方式">
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource CardBody}">
                                        擷取框會保持在最上層，可移動或調整大小，並讀取框內文字。你可以選取文字邊界、讀取框內所有內容、載入圖片或 PDF、放大檢視，或切換至表格處理流程。
                                    </TextBlock>
                                </Expander>

                                <Expander Margin="0,12,0,0" Header="文字編輯視窗的功能">
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource CardBody}">
                                        文字編輯是用來修正 OCR 輸出的純文字工作區，提供修剪空白、變更大小寫、隔離選取內容、取代保留字元、尋找及取代，以及擷取規則運算式比對結果等工具。
                                    </TextBlock>
                                </Expander>

                                <Expander Margin="0,12,0,0" Header="快速查詢的使用時機">
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource CardBody}">
                                        快速查詢是搭配 OCR 使用的非 OCR 模式。你可以儲存可重複使用的文字項目、即時搜尋，按 Enter 複製，再將結果貼到需要的位置。
                                    </TextBlock>
                                </Expander>

                                <Border
                                    Margin="0,20,0,0"
                                    Padding="16"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <TextBlock Style="{StaticResource CardBody}">
                                        日後若想再次查看導覽總覽，可隨時從設定重新開啟此畫面。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="0,28,0,0" Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="設定完成。" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SectionBody}"
                                    Text="立即使用所選模式、前往設定調整完整選項，或查看應用程式隨附的授權資訊。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Margin="24,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="LicensesButton"
                                    AutomationProperties.AutomationId="FirstRun.LicensesButton"
                                    Width="120"
                                    Margin="0,0,12,0"
                                    Click="LicensesButton_Click"
                                    Style="{StaticResource WelcomeSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="DocumentText24" />
                                        <TextBlock Text="授權" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Width="140"
                                    Margin="0,0,12,0"
                                    Click="SettingsButton_Click"
                                    Style="{StaticResource WelcomeSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Settings24" />
                                        <TextBlock Text="開啟設定" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Width="210"
                                    Click="OkayButton_Click"
                                    Style="{StaticResource TealColor}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Checkmark24" />
                                        <TextBlock Foreground="White" Text="以選取的模式開始" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
