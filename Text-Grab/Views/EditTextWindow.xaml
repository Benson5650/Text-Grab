                    <Button
                        x:Name="SimilarMatchesButton"
                        Margin="0,0,8,0"
                        Padding="4,2"
                        AutomationProperties.AutomationId="EditText.SimilarMatchesButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SimilarMatchesButton_Click"
                        ContextMenuOpening="PatternContextOpening"
                        Cursor="Hand"
                        MouseWheel="PatternButton_MouseWheel"
                        ToolTip="按一下以使用模式尋找及取代"
                        Visibility="Collapsed">
                        <TextBlock
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            Text="0 similar" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    x:Name="SavePatternMenuItem"
                                    Click="SavePatternMenuItem_Click"
                                    Header="儲存模式" />
                                <MenuItem
                                    x:Name="ExplainPatternMenuItem"
                                    Click="ExplainPatternMenuItem_Click"
                                    Header="說明模式" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        x:Name="RegexPatternButton"
                        Margin="0,0,8,0"
                        Padding="4,2"
                        AutomationProperties.AutomationId="EditText.RegexPatternButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="RegexPatternButton_Click"
                        ContextMenuOpening="PatternContextOpening"
                        Cursor="Hand"
                        MouseWheel="PatternButton_MouseWheel"
                        ToolTip="按一下以使用規則運算式開啟尋找及取代"
                        Visibility="Collapsed">
                        <TextBlock
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            Text="規則運算式： " />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    x:Name="SavePatternMenuItem2"
                                    Click="SavePatternMenuItem_Click"
                                    Header="儲存模式" />
                                <MenuItem
                                    x:Name="ExplainPatternMenuItem2"
                                    Click="ExplainPatternMenuItem_Click"
                                    Header="說明模式" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        x:Name="CharDetailsButton"
                        Margin="0,0,8,0"
                        Padding="4,2"
                        AutomationProperties.AutomationId="EditText.CharacterDetailsButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CharDetailsButton_Click"
                        Cursor="Hand"
                        ToolTip="按一下查看字元詳細資訊"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="CharDetailsButtonText"
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            Text="U+0000" />
                    </Button>
                    <TextBlock
                        x:Name="BottomBarText"
                        AutomationProperties.AutomationId="EditText.StatusText"
                        FontFamily="Cascadia Mono"
                        Text="Ln 1, Col 0" />
                </StackPanel>
                <Popup
                    x:Name="CharDetailsPopup"
                    Grid.Column="1"
                    AllowsTransparency="True"
                    Placement="Top"
                    PlacementTarget="{Binding ElementName=CharDetailsButton}"
                    StaysOpen="False">
                    <Border
                        Padding="16"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel x:Name="CharDetailsPopupContent" Width="300" />
                    </Border>
                </Popup>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="EditBottomBarMenuItem_Click" Header="編輯底部工具列" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </ScrollViewer>
        <StackPanel
            x:Name="LoadingStack"
            Grid.RowSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="EditText.LoadingStatus"
            Orientation="Vertical"
            Visibility="Collapsed">
            <ui:ProgressRing
                x:Name="ProgressRing"
                Width="60"
                Height="60"
                IsIndeterminate="True" />
            <TextBlock
                x:Name="ProgressText"
                Margin="0,12,0,0"
                AutomationProperties.AutomationId="EditText.ProgressText"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="處理中…" />
        </StackPanel>
        <!--  Non-blocking, cancellable status shown while transcribing audio; text streams into the editor beneath it.  -->
        <Border
            x:Name="TranscriptionStatusBar"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            Padding="12,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Panel.ZIndex="500"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    IsIndeterminate="True" />
                <StackPanel
                    MinWidth="140"
                    Margin="10,0,12,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TranscriptionStatusText"
                        VerticalAlignment="Center"
                        Text="轉錄中…" />
                    <!--  Determinate: how far through the current clip's duration transcription has reached.  -->
                    <ProgressBar
                        x:Name="TranscriptionProgressBar"
                        Height="4"
                        Margin="0,4,0,0"
                        Maximum="100"
                        Minimum="0"
                        Visibility="Collapsed"
                        Value="0" />
                </StackPanel>
                <Button
                    x:Name="TranscriptionCancelButton"
                    Padding="10,2"
                    Click="TranscriptionCancelButton_Click"
                    Content="取消" />
            </StackPanel>
        </Border>
        <ui:ContentDialogHost
            x:Name="PendingFileCloseDialogHost"
            Grid.RowSpan="4"
            Panel.ZIndex="999"
            AutomationProperties.AutomationId="EditText.PendingFileCloseDialog"
            IsDisableSiblingsEnabled="True" />
    </Grid>
</ui:FluentWindow>
