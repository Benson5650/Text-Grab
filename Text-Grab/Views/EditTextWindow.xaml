<ui:FluentWindow
    x:Class="Text_Grab.EditTextWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="文字編輯"
    Width="800"
    Height="500"
    MinWidth="200"
    MinHeight="200"
    Activated="Window_Activated"
    AutomationProperties.AutomationId="EditTextWindow"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    Closed="Window_Closed"
    Closing="Window_Closing"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Initialized="Window_Initialized"
    Loaded="Window_Loaded"
    PreviewKeyDown="EditTextWindow_PreviewKeyDown"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="SimpleBTN" TargetType="Button">
            <Setter Property="Width" Value="120" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="10,10,0,10" />
        </Style>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />
        <ContextMenu x:Key="ContextMenuResource">
            <MenuItem Command="ApplicationCommands.Undo" />
            <MenuItem Command="ApplicationCommands.Redo" />
            <Separator />
            <MenuItem Command="ApplicationCommands.Cut" />
            <MenuItem Command="ApplicationCommands.Copy" />
            <MenuItem Command="ApplicationCommands.Paste" />
            <MenuItem
                Command="{x:Static local:EditTextWindow.OcrPasteCommand}"
                Header="OCR 貼上"
                InputGestureText="Ctrl + Shift + V" />
            <Separator />
            <MenuItem
                Command="{x:Static local:EditTextWindow.IsolateSelectionCmd}"
                Header="隔離選取文字"
                InputGestureText="Ctrl + I" />
            <MenuItem
                Click="SelectLineMenuItem_Click"
                Header="選取行"
                InputGestureText="Ctrl + L" />
            <MenuItem
                Click="SelectAllMenuItem_Click"
                Header="全選"
                InputGestureText="Ctrl + A" />
            <MenuItem
                Command="{x:Static local:EditTextWindow.ToggleCaseCmd}"
                Header="切換大小寫"
                InputGestureText="Shift + F3" />
            <MenuItem Click="DeleteSelectedTextMenuItem_Click" Header="刪除選取文字" />
            <Separator />
            <MenuItem
                Click="MoveLineUpMenuItem_Click"
                Header="上移選取項目"
                InputGestureText="Alt + Up" />
            <MenuItem
                Click="MoveLineDownMenuItem_Click"
                Header="下移選取項目"
                InputGestureText="Alt + Down" />
            <MenuItem Click="ShuffleLinesMenuItem_Click" Header="隨機排列行" />
        </ContextMenu>
        <ContextMenu x:Key="MarkdownContextMenu">
            <MenuItem Command="ApplicationCommands.Undo" />
            <MenuItem Command="ApplicationCommands.Redo" />
            <Separator />
            <MenuItem Command="ApplicationCommands.Cut" />
            <MenuItem Command="ApplicationCommands.Copy" />
            <MenuItem Command="ApplicationCommands.Paste" />
            <Separator />
            <MenuItem Command="ApplicationCommands.SelectAll" />
        </ContextMenu>
        <ContextMenu x:Key="SpreadsheetContextMenu" Opened="SpreadsheetContextMenu_Opened">
            <MenuItem Click="AddSpreadsheetRowMenuItem_Click" Header="在下方新增資料列" />
            <MenuItem Click="AddSpreadsheetColumnMenuItem_Click" Header="在右側新增欄" />
            <MenuItem Click="SplitSpreadsheetCellsMenuItem_Click" Header="分割為多欄…" />
            <Separator />
            <MenuItem Command="ApplicationCommands.Cut" />
            <MenuItem Command="ApplicationCommands.Copy" />
            <MenuItem Command="ApplicationCommands.Paste" />
            <Separator />
            <MenuItem
                Click="ToggleSpreadsheetWrapTextMenuItem_Click"
                Header="文字換行"
                IsCheckable="True"
                Tag="SpreadsheetWrapTextToggle" />
            <Separator />
            <MenuItem Click="CopySpreadsheetRowsMenuItem_Click" Header="複製選取的資料列" />
            <MenuItem Click="CopySpreadsheetColumnMenuItem_Click" Header="複製目前欄" />
            <MenuItem Click="CopySpreadsheetAsMarkdownMenuItem_Click" Header="複製為 Markdown 表格" />
        </ContextMenu>
        <ContextMenu x:Key="SpreadsheetRowHeaderContextMenu">
            <MenuItem Click="MoveSpreadsheetRowUpMenuItem_Click" Header="上移資料列" />
            <MenuItem Click="MoveSpreadsheetRowDownMenuItem_Click" Header="下移資料列" />
            <Separator />
            <MenuItem Click="DeleteSpreadsheetRowMenuItem_Click" Header="刪除資料列" />
        </ContextMenu>
        <ContextMenu x:Key="SpreadsheetColumnHeaderContextMenu">
            <MenuItem Click="MoveSpreadsheetColumnLeftMenuItem_Click" Header="左移欄" />
            <MenuItem Click="MoveSpreadsheetColumnRightMenuItem_Click" Header="右移欄" />
            <Separator />
            <MenuItem Click="DeleteSpreadsheetColumnMenuItem_Click" Header="刪除欄" />
        </ContextMenu>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding
            CanExecute="SplitOnSelectionCmdCanExecute"
            Command="{x:Static local:EditTextWindow.SplitOnSelectionCmd}"
            Executed="SplitOnSelectionCmdExecuted" />
        <CommandBinding
            CanExecute="SplitOnSelectionCmdCanExecute"
            Command="{x:Static local:EditTextWindow.SplitAfterSelectionCmd}"
            Executed="SplitAfterSelectionCmdExecuted" />
        <CommandBinding
            CanExecute="IsolateSelectionCmdCanExecute"
            Command="{x:Static local:EditTextWindow.IsolateSelectionCmd}"
            Executed="IsolateSelectionCmdExecuted" />
        <CommandBinding
            CanExecute="SingleLineCmdCanExecute"
            Command="{x:Static local:EditTextWindow.SingleLineCmd}"
            Executed="SingleLineCmdExecuted" />
        <CommandBinding
            CanExecute="ToggleCaseCmdCanExecute"
            Command="{x:Static local:EditTextWindow.ToggleCaseCmd}"
            Executed="ToggleCase" />
        <CommandBinding
            CanExecute="ReplaceReservedCharsCmdCanExecute"
            Command="{x:Static local:EditTextWindow.ReplaceReservedCmd}"
            Executed="ReplaceReservedCharsCmdExecuted" />
        <CommandBinding
            CanExecute="SelectionContainsNewLinesCmdCanExecute"
            Command="{x:Static local:EditTextWindow.UnstackCmd}"
            Executed="UnstackExecuted" />
        <CommandBinding
            CanExecute="SelectionContainsNewLinesCmdCanExecute"
            Command="{x:Static local:EditTextWindow.UnstackGroupCmd}"
            Executed="UnstackGroupExecuted" />
        <CommandBinding
            CanExecute="IsolateSelectionCmdCanExecute"
            Command="{x:Static local:EditTextWindow.DeleteAllSelectionCmd}"
            Executed="DeleteAllSelectionExecuted" />
        <CommandBinding
            CanExecute="IsolateSelectionCmdCanExecute"
            Command="{x:Static local:EditTextWindow.DeleteAllSelectionPatternCmd}"
            Executed="DeleteAllSelectionPatternExecuted" />
        <CommandBinding
            CanExecute="InsertSelectionOnEveryLineCmdCanExecute"
            Command="{x:Static local:EditTextWindow.InsertSelectionOnEveryLineCmd}"
            Executed="InsertSelectionOnEveryLine" />
        <CommandBinding
            CanExecute="CanOcrPasteExecute"
            Command="{x:Static local:EditTextWindow.OcrPasteCommand}"
            Executed="PasteExecuted" />
        <CommandBinding
            CanExecute="CanLaunchUriExecute"
            Command="{x:Static local:EditTextWindow.LaunchCmd}"
            Executed="LaunchUriExecuted" />
        <CommandBinding
            CanExecute="MakeQrCodeCanExecute"
            Command="{x:Static local:EditTextWindow.MakeQrCodeCmd}"
            Executed="MakeQrCodeExecuted" />
        <CommandBinding
            CanExecute="TransposeTableCmdCanExecute"
            Command="{x:Static local:EditTextWindow.TransposeTableCmd}"
            Executed="TransposeTableExecuted" />
        <CommandBinding
            CanExecute="CanSearchSelectionExecute"
            Command="{x:Static local:EditTextWindow.WebSearchCmd}"
            Executed="WebSearchExecuted" />
        <CommandBinding
            CanExecute="CanSearchSelectionExecute"
            Command="{x:Static local:EditTextWindow.DefaultWebSearchCmd}"
            Executed="DefaultWebSearchExecuted" />
    </Window.CommandBindings>
    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            x:Name="UiTitleBar"
            Title="文字編輯"
            Height="32"
            Margin="2,2,2,0"
            Padding="8,2"
            AutomationProperties.AutomationId="EditText.TitleBar"
            Icon="{StaticResource TextGrabIcon}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Menu
                Grid.Column="0"
                ClipToBounds="True"
                IsMainMenu="True">
                <MenuItem
                    AutomationProperties.AutomationId="EditText.Menu.File"
                    Header="_File"
                    SubmenuOpened="MenuItem_SubmenuOpened">
                    <MenuItem
                        x:Name="OpenFileMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.OpenFile"
                        Click="OpenFileMenuItem_Click"
                        Header="_開啟檔案..."
                        InputGestureText="Ctrl + O" />
                    <MenuItem x:Name="OpenRecentMenuItem" Header="最近使用" />
                    <MenuItem x:Name="OpenRecentGrabsMenuItem" Header="最近擷取" />
                    <MenuItem x:Name="OpenRecentPdfsMenuItem" Header="最近的 PDF" />
                    <MenuItem
                        x:Name="SaveFileMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.Save"
                        Click="SaveBTN_Click"
                        Header="_Save"
                        InputGestureText="Ctrl + S" />
                    <MenuItem
                        x:Name="SaveAsFileMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.SaveAs"
                        Click="SaveAsBTN_Click"
                        Header="Save _As..."
                        InputGestureText="Ctrl + Shift + S" />
                    <MenuItem
                        x:Name="CopyAndCloseMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.CopyAndClose"
                        Click="CopyCloseBTN_Click"
                        Header="複製並關閉" />
                    <MenuItem
                        x:Name="CloseAndInsertMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.CloseAndInsert"
                        Click="CopyClosePasteBTN_Click"
                        Header="關閉並插入" />
                    <Separator />
                    <MenuItem
                        x:Name="SettingsMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.OpenSettings"
                        Click="SettingsMenuItem_Click"
                        Header="Text Grab 設定..." />
                    <MenuItem
                        x:Name="CloseMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.Close"
                        Click="CloseMenuItem_Click"
                        Header="關閉"
                        InputGestureText="Alt + F4" />
                </MenuItem>
                <MenuItem
                    AutomationProperties.AutomationId="EditText.Menu.Edit"
                    Header="_Edit"
                    SubmenuOpened="EditMenuItem_SubmenuOpened">
                    <MenuItem Command="ApplicationCommands.Undo" />
                    <MenuItem Command="ApplicationCommands.Redo" />
                    <Separator />
                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                    <MenuItem
                        Command="{x:Static local:EditTextWindow.OcrPasteCommand}"
                        Header="OCR 貼上"
                        InputGestureText="Ctrl + Shift + V" />
                    <Separator />
                    <MenuItem
                        x:Name="LaunchUriMenuItem"
                        Command="{x:Static local:EditTextWindow.LaunchCmd}"
                        Header="開啟 URL" />
                    <MenuItem
                        x:Name="SingleLineMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.SingleLine"
                        Command="{x:Static local:EditTextWindow.SingleLineCmd}"
                        Header="合併為單行" />
                    <MenuItem
                        x:Name="JoinLinesMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.JoinLines"
                        Click="JoinLinesMenuItem_Click"
                        Header="合併行..." />
                    <MenuItem
                        x:Name="_TrimEachLineMenuItem"
                        Click="TrimEachLineMenuItem_Click"
                        Header="修剪每一行" />
                    <MenuItem
                        x:Name="CleanUpTextMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.CleanUpText"
                        Click="CleanUpText_Click"
                        Header="整理文字" />
                    <MenuItem
                        x:Name="TryToNumberMenuItem"
                        Click="TryToNumberMenuItem_Click"
                        Header="嘗試轉換為數字" />
                    <MenuItem
                        x:Name="TryToAlphaMenuItem"
                        Click="TryToAlphaMenuItem_Click"
                        Header="嘗試轉換為字母" />
                    <MenuItem
                        x:Name="CorrectGuid"
                        Click="CorrectGuid_Click"
                        Header="修正常見 GUID/UUID 錯誤" />
                    <MenuItem
                        x:Name="ToggleCaseMenuItem"
                        Command="{x:Static local:EditTextWindow.ToggleCaseCmd}"
                        Header="Toggle _Case"
                        InputGestureText="Shift + F3" />
                    <MenuItem
                        x:Name="RemoveDuplicateLines"
                        Click="RemoveDuplicateLines_Click"
                        Header="移除重複行" />
                    <MenuItem
                        x:Name="ShuffleLinesMenuItem"
                        Click="ShuffleLinesMenuItem_Click"
                        Header="隨機排列行" />
                    <MenuItem
                        x:Name="ReplaceReservedCharsMenuItem"
                        Command="{x:Static local:EditTextWindow.ReplaceReservedCmd}"
                        Header="取代保留字元"
                        InputGestureText="Ctrl + R" />
                    <MenuItem
                        x:Name="UnStackMenuItem"
                        Command="{x:Static local:EditTextWindow.UnstackCmd}"
                        Header="取消文字堆疊（選取頂端資料列）"
                        InputGestureText="Ctrl + U" />
                    <MenuItem
                        x:Name="UnStackGroupMenuItem"
                        Command="{x:Static local:EditTextWindow.UnstackGroupCmd}"
                        Header="取消文字堆疊（選取第一欄）" />
                    <MenuItem
                        x:Name="AddRemoveAtMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.AddRemoveLimit"
                        Click="AddRemoveAtMenuItem_Click"
                        Header="_Add, Remove, Limit..." />
                    <MenuItem Command="{x:Static local:EditTextWindow.TransposeTableCmd}" Header="轉置表格" />
                    <MenuItem x:Name="ApplyMenuItem" Header="套用擷取範本或規則運算式">
                        <MenuItem
                            x:Name="ApplyGrabTemplateMenuItem"
                            Header="擷取範本"
                            Visibility="Collapsed" />
                        <MenuItem x:Name="ApplyPatternMenuItem" Header="模式" />
                        <MenuItem x:Name="ApplySmartPatternMenuItem" Header="智慧規則運算式" />
                    </MenuItem>
                    <MenuItem x:Name="ApplyPerLineMenuItem" Header="逐行套用（範本或規則運算式）">
                        <MenuItem
                            x:Name="ApplyGrabTemplatePerLineMenuItem"
                            Header="擷取範本"
                            Visibility="Collapsed" />
                        <MenuItem x:Name="ApplyPatternPerLineMenuItem" Header="模式" />
                        <MenuItem x:Name="ApplySmartPatternPerLineMenuItem" Header="智慧規則運算式" />
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="AddSpreadsheetRowMenuItem"
                        Click="AddSpreadsheetRowMenuItem_Click"
                        Header="新增試算表資料列"
                        Visibility="Collapsed" />
                    <MenuItem
                        x:Name="AddSpreadsheetColumnMenuItem"
                        Click="AddSpreadsheetColumnMenuItem_Click"
                        Header="新增試算表欄"
                        Visibility="Collapsed" />
                </MenuItem>
                <MenuItem AutomationProperties.AutomationId="EditText.Menu.Selection" Header="_Selection">
                    <MenuItem
                        x:Name="FindAndReplaceMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.FindAndReplace"
                        Click="FindAndReplaceMenuItem_Click"
                        Header="尋找及取代"
                        InputGestureText="Ctrl + Shift + F" />
                    <MenuItem
                        x:Name="DefaultWebSearch"
                        Command="{x:Static local:EditTextWindow.DefaultWebSearchCmd}"
                        Header="預設網頁搜尋" />
                    <MenuItem x:Name="WebSearchCollection" Header="使用下列方式搜尋網路..." />
                    <Separator />
                    <MenuItem
                        x:Name="SelectWordMenuItem"
                        Click="SelectWordMenuItem_Click"
                        Header="Select _Word"
                        InputGestureText="Ctrl + W" />
                    <MenuItem
                        x:Name="SelectLineMenuItem"
                        Click="SelectLineMenuItem_Click"
                        Header="Select _Line"
                        InputGestureText="Ctrl + L" />
                    <MenuItem
                        x:Name="SelectAllMenuItem"
                        Click="SelectAllMenuItem_Click"
                        Header="全選"
                        InputGestureText="Ctrl + A" />
                    <MenuItem
                        x:Name="SelectNoneMenuItem"
                        Click="SelectNoneMenuItem_Click"
                        Header="取消全選" />
                    <MenuItem
                        x:Name="DeleteSelectedTextMenuItem"
                        Click="DeleteSelectedTextMenuItem_Click"
                        Header="刪除選取文字" />
                    <Separator />
                    <MenuItem
                        x:Name="MoveLineUpMenuItem"
                        Click="MoveLineUpMenuItem_Click"
                        Header="上移選取項目"
                        InputGestureText="Alt + Up" />
                    <MenuItem
                        x:Name="MoveLineDownMenuItem"
                        Click="MoveLineDownMenuItem_Click"
                        Header="下移選取項目"
                        InputGestureText="Alt + Down" />
                    <Separator />
                    <MenuItem
                        x:Name="SplitLineBeforeSelectionMI"
                        Command="{x:Static local:EditTextWindow.SplitOnSelectionCmd}"
                        Header="在每個選取內容前分割行" />
                    <MenuItem
                        x:Name="SplitLineAfterSelectionMI"
                        Command="{x:Static local:EditTextWindow.SplitAfterSelectionCmd}"
                        Header="在每個選取內容後分割行" />
                    <MenuItem
                        x:Name="IsolateSelectionMI"
                        Command="{x:Static local:EditTextWindow.IsolateSelectionCmd}"
                        Header="隔離選取文字"
                        InputGestureText="Ctrl + I" />
                    <MenuItem
                        x:Name="DeleteAllSelectionMI"
                        Command="{x:Static local:EditTextWindow.DeleteAllSelectionCmd}"
                        Header="刪除所有選取內容" />
                    <MenuItem
                        x:Name="DeleteAllSelectionPatternMI"
                        Command="{x:Static local:EditTextWindow.DeleteAllSelectionPatternCmd}"
                        Header="刪除所有符合簡易模式的選取內容" />
                    <MenuItem
                        x:Name="InsertSelectionOnEveryLineMI"
                        Command="{x:Static local:EditTextWindow.InsertSelectionOnEveryLineCmd}"
                        Header="將選取內容插入每一行" />
                </MenuItem>
                <MenuItem
                    Name="AiMenuItem"
                    Header="本機 AI"
                    Visibility="Collapsed">
                    <MenuItem
                        x:Name="SummarizeMenuItem"
                        Click="SummarizeMenuItem_Click"
                        Header="摘要段落" />
                    <MenuItem
                        x:Name="MeetingNotesMenuItem"
                        Click="MeetingNotesMenuItem_Click"
                        Header="整理為會議記錄" />
                    <MenuItem
                        x:Name="RewriteMenuItem"
                        Click="RewriteMenuItem_Click"
                        Header="_Rewrite" />
                    <MenuItem
                        x:Name="ConvertTableMenuItem"
                        Click="ConvertTableMenuItem_Click"
                        Header="轉換為表格" />
                    <MenuItem
                        x:Name="TranslateToSystemLanguageMenuItem"
                        Click="TranslateToSystemLanguageMenuItem_Click"
                        Header="翻譯為系統語言" />
                    <MenuItem x:Name="TranslateMenuItem" Header="翻譯為...">
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="英文"
                            Tag="English" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="西班牙文"
                            Tag="Spanish" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="法文"
                            Tag="French" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="德文"
                            Tag="German" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="義大利文"
                            Tag="Italian" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="葡萄牙文"
                            Tag="Portuguese" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="俄文"
                            Tag="Russian" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="日文"
                            Tag="Japanese" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="簡體中文"
                            Tag="Chinese (Simplified)" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="韓文"
                            Tag="Korean" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="阿拉伯文"
                            Tag="Arabic" />
                        <MenuItem
                            Click="TranslateMenuItem_Click"
                            Header="印地文"
                            Tag="Hindi" />
                    </MenuItem>
                    <MenuItem
                        x:Name="ExtractRegexMenuItem"
                        Click="ExtractRegexMenuItem_Click"
                        Header="擷取規則運算式" />
                    <Separator />
                    <MenuItem
                        x:Name="SendLocalAiResultToNewWindowMenuItem"
                        Checked="SendLocalAiResultToNewWindowMenuItem_Checked"
                        Header="將結果傳送至新視窗"
                        IsCheckable="True"
                        Unchecked="SendLocalAiResultToNewWindowMenuItem_Unchecked" />
                    <MenuItem
                        x:Name="NotifyOnLocalAiCompleteMenuItem"
                        Checked="NotifyOnLocalAiCompleteMenuItem_Checked"
                        Header="完成時通知"
                        IsCheckable="True"
                        Unchecked="NotifyOnLocalAiCompleteMenuItem_Unchecked" />
                    <Separator />
                    <MenuItem
                        x:Name="RestartLocalLlmMenuItem"
                        Click="RestartLocalLlmMenuItem_Click"
                        Header="重新啟動本機 LLM" />
                    <MenuItem
                        x:Name="LearnAiMenuItem"
                        Click="LearnAiMenuItem_Click"
                        Header="_了解本機 AI 功能..." />
                </MenuItem>
                <MenuItem AutomationProperties.AutomationId="EditText.Menu.Format" Header="F_ormat">
                    <MenuItem
                        x:Name="RawTextModeMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.RawTextMode"
                        Click="EditorModeMenuItem_Click"
                        Header="原始文字"
                        IsCheckable="True" />
                    <MenuItem
                        x:Name="SpreadsheetModeMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.SpreadsheetMode"
                        Click="EditorModeMenuItem_Click"
                        Header="試算表"
                        IsCheckable="True" />
                    <MenuItem
                        x:Name="MarkdownModeMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.MarkdownMode"
                        Click="EditorModeMenuItem_Click"
                        Header="Markdown"
                        IsCheckable="True" />
                    <Separator />
                    <MenuItem
                        x:Name="ShowErrorsMenuItem"
                        Click="ShowErrorsMenuItem_Click"
                        Header="顯示計算錯誤"
                        IsCheckable="True" />
                    <MenuItem
                        x:Name="MarginsMenuItem"
                        Checked="MarginsMenuItem_Checked"
                        Header="使用邊界"
                        IsCheckable="True"
                        Unchecked="MarginsMenuItem_Checked" />
                    <MenuItem
                        x:Name="WrapTextMenuItem"
                        Checked="WrapTextCHBX_Checked"
                        Header="文字換行"
                        IsCheckable="True"
                        IsChecked="True"
                        Unchecked="WrapTextCHBX_Checked" />
                    <MenuItem
                        x:Name="FontMenuItem"
                        Click="FontMenuItem_Click"
                        Header="_Font..." />
                    <Separator />
                    <MenuItem x:Name="SpellCheckMenuItem" Header="Spell _Check">
                        <MenuItem
                            x:Name="SpellCheckAutoMenuItem"
                            Click="SpellCheckModeMenuItem_Click"
                            Header="_Auto"
                            IsCheckable="True"
                            Tag="Auto" />
                        <MenuItem
                            x:Name="SpellCheckAlwaysOnMenuItem"
                            Click="SpellCheckModeMenuItem_Click"
                            Header="Always _On"
                            IsCheckable="True"
                            Tag="AlwaysOn" />
                        <MenuItem
                            x:Name="SpellCheckOffMenuItem"
                            Click="SpellCheckModeMenuItem_Click"
                            Header="O_ff"
                            IsCheckable="True"
                            Tag="Off" />
                    </MenuItem>
                </MenuItem>
                <MenuItem
                    x:Name="CaptureMenuItem"
                    AutomationProperties.AutomationId="EditText.Menu.Capture"
                    Header="_Capture"
                    SubmenuOpened="CaptureMenuItem_SubmenuOpened">
                    <MenuItem
                        x:Name="FullScreenGrabMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.FullscreenGrab"
                        Click="FullScreenGrabMenuItem_Click"
                        Header="新增全螢幕擷取"
                        InputGestureText="Ctrl + F" />
                    <MenuItem
                        x:Name="FSGDelayMenuItem"
                        Click="FSGDelayMenuItem_Click"
                        Header="延遲 2 秒後全螢幕擷取" />
                    <MenuItem
                        x:Name="PreviousRegionMenuItem"
                        Click="PreviousRegion_Click"
                        Header="擷取上一個區域" />
                    <MenuItem
                        x:Name="GrabFrameMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.GrabFrame"
                        Click="GrabFrameMenuItem_Click"
                        Header="新增擷取框"
                        InputGestureText="Ctrl + G" />
                    <MenuItem
                        x:Name="CaptureFromCameraMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.CaptureFromCamera"
                        Click="CaptureFromCameraMenuItem_Click"
                        Header="從相機擷取..." />
                    <MenuItem
                        x:Name="ManageGrabTemplatesMenuItem"
                        Click="ManageGrabTemplates_Click"
                        Header="管理擷取範本..." />
                    <MenuItem
                        x:Name="RegexManagerMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.RegexManager"
                        Click="RegexManagerMenuItem_Click"
                        Header="開啟規則運算式管理員..." />
                    <Separator />
                    <MenuItem
                        x:Name="QuickSimpleLookupMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.QuickLookup"
                        Click="LaunchQuickSimpleLookup"
                        Header="從快速查詢新增"
                        InputGestureText="Ctrl + Q" />
                    <MenuItem
                        x:Name="ClipboardWatcherMenuItem"
                        AutomationProperties.AutomationId="EditText.Menu.ClipboardWatcher"
                        Header="監看剪貼簿變更"
                        IsCheckable="True"
                        IsChecked="False" />
                    <MenuItem
