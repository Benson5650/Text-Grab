                            <Run Text="100 fahrenheit to celsius" /><LineBreak />
                            <Run Text="3.5 gallons to liters" /><LineBreak />
                            <Run Text="3.6 years to days" /><LineBreak />
                            <Run Text="5-14-26 - 1-12-25 in weeks" />
