<ui:FluentWindow
    x:Class="Text_Grab.Views.QuickSimpleLookup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="快速查詢"
    AutomationProperties.AutomationId="QuickLookupWindow"
    Width="800"
    Height="400"
    Closed="FluentWindow_Closed"
    Closing="FluentWindow_Closing"
    Loaded="Window_Loaded"
    PreviewKeyDown="QuickSimpleLookup_PreviewKeyDown"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />

        <Style x:Key="CellTextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="快速查詢"
            Height="32"
            Margin="2,2,2,0"
            Padding="8,2"
            Icon="{StaticResource TextGrabIcon}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <controls:SearchBar
                x:Name="SearchBar"
                AutomationProperties.AutomationId="QuickLookup.Search"
                Grid.Column="0"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                AcceptsTab="True"
                PlaceholderText="輸入文字以搜尋..."
                SearchChanged="SearchBar_SearchChanged" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <controls:CollapsibleButton
                    x:Name="AddItemBtn"
                    AutomationProperties.AutomationId="QuickLookup.AddItemButton"
                    Background="DarkGreen"
                    ButtonSymbol="Add24"
                    ButtonText="新增項目"
                    Click="AddItemBtn_Click"
                    Foreground="White"
                    Visibility="Collapsed" />
                <controls:CollapsibleButton
                    x:Name="NewFullscreen"
                    AutomationProperties.AutomationId="QuickLookup.NewFullscreenButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ButtonSymbol="SlideAdd24"
                    ButtonText="新增全螢幕擷取"
                    Click="NewFullscreen_Click"
                    IsSymbol="True"
                    ToolTip="新增全螢幕擷取 (Ctrl + F)" />
                <controls:CollapsibleButton
                    x:Name="SaveBTN"
                    AutomationProperties.AutomationId="QuickLookup.SaveButton"
                    ButtonSymbol="Save24"
                    ButtonText="儲存查詢資料"
                    Click="SaveBTN_Click"
                    IsSymbol="True"
                    ToolTip="儲存查詢資料"
                    Visibility="Collapsed" />
                <ToggleButton
                    x:Name="PasteToggleButton"
                    AutomationProperties.AutomationId="QuickLookup.InsertToggle"
                    AutomationProperties.Name="將選取的值插入先前使用的應用程式"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Padding="7,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Checked="PasteToggleButton_Checked"
                    Style="{StaticResource ToggleSymbolButton}"
                    ToolTip="(Ctrl + I) 複製時插入此值"
                    Unchecked="PasteToggleButton_Checked">
                    <ui:SymbolIcon Symbol="ClipboardPaste24" />
                </ToggleButton>
                <ToggleButton
                    x:Name="EditWindowToggleButton"
                    AutomationProperties.AutomationId="QuickLookup.SendToEditTextToggle"
                    AutomationProperties.Name="將選取的值傳送至文字編輯視窗"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Padding="7,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Checked="EditWindowToggleButton_Checked"
                    Style="{StaticResource ToggleSymbolButton}"
                    ToolTip="(Ctrl + E) 將值傳送至文字編輯視窗"
                    Unchecked="EditWindowToggleButton_Checked">
                    <ui:SymbolIcon Symbol="Window24" />

                </ToggleButton>
                <Menu
                    Grid.Column="1"
                    Height="32"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    IsMainMenu="True">
                    <MenuItem AutomationProperties.AutomationId="QuickLookup.MoreMenu" AutomationProperties.Name="更多查詢動作">
                        <MenuItem.Header>
                            <TextBlock
                                Height="40"
                                Padding="4,12"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Text="" />
                        </MenuItem.Header>
                        <MenuItem
                            x:Name="SaveMenuItem"
                            AutomationProperties.AutomationId="QuickLookup.Menu.Save"
                            Click="SaveBTN_Click"
                            Header="儲存查詢資料" />
                        <MenuItem
                            x:Name="PickSaveLocation"
                            AutomationProperties.AutomationId="QuickLookup.Menu.ChangeFileLocation"
                            Click="PickSaveLocation_Click"
                            Header="變更查詢資料檔案位置..." />
                        <MenuItem
                            x:Name="ParseClipboardMenuItem"
                            AutomationProperties.AutomationId="QuickLookup.Menu.ParseClipboard"
                            Click="ParseBTN_Click"
                            Header="解析從 Excel 複製的表格" />
                        <MenuItem
                            x:Name="ParseCSVFileMenuItem"
                            AutomationProperties.AutomationId="QuickLookup.Menu.ImportCsv"
                            Click="ParseCSVFileMenuItem_Click"
                            Header="從 CSV 檔案新增資料列..." />
                        <MenuItem
                            x:Name="SearchHistory"
                            AutomationProperties.AutomationId="QuickLookup.Menu.SearchHistory"
                            Click="SearchHistory_Click"
                            Header="搜尋記錄"
                            IsCheckable="True" />
                        <MenuItem
                            x:Name="TextGrabSettingsMenuItem"
                            AutomationProperties.AutomationId="QuickLookup.Menu.OpenSettings"
                            Click="TextGrabSettingsMenuItem_Click"
                            Header="Text Grab 設定" />
                    </MenuItem>
                </Menu>
                <controls:CollapsibleButton
                    x:Name="EnterButton"
                    AutomationProperties.AutomationId="QuickLookup.CopySelectedButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ButtonSymbol="ArrowRight24"
                    ButtonText="輸入"
                    Click="EnterButton_Click"
                    IsSymbol="True"
                    ToolTip="前往（Enter）">
                    <controls:CollapsibleButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="EnterShiftMI_Click" Header="Shift + Enter" />
                            <MenuItem Click="EnterCtrlMI_Click" Header="Ctrl + Enter" />
                            <MenuItem Click="EnterAltMI_Click" Header="Alt + Enter" />
                            <MenuItem Click="EnterShiftCtrlMI_Click" Header="Shift + Ctrl + Enter" />
                        </ContextMenu>
                    </controls:CollapsibleButton.ContextMenu>
                </controls:CollapsibleButton>
            </StackPanel>
        </Grid>
        <DataGrid
            x:Name="MainDataGrid"
            AutomationProperties.AutomationId="QuickLookup.ResultsGrid"
            Grid.Row="2"
            AlternatingRowBackground="{DynamicResource ApplicationBackgroundBrush}"
            AutoGenerateColumns="False"
            Background="Transparent"
            BeginningEdit="MainDataGrid_BeginningEdit"
            CanUserAddRows="True"
            CanUserDeleteRows="True"
            CanUserResizeRows="True"
            CellEditEnding="MainDataGrid_CellEditEnding"
            CellStyle="{DynamicResource DataGridCellStyleDark}"
            ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyleDark}"
            HorizontalScrollBarVisibility="Disabled"
            ItemsSource="{Binding ItemsDictionary}"
            MinRowHeight="14"
            RowBackground="Transparent"
            RowStyle="{DynamicResource DataGridRowStyleDark}"
            SelectionChanged="MainDataGrid_SelectionChanged"
            SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.Header>
                        <TextBlock
                            Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                            Style="{StaticResource CellTextBlock}"
                            Text="" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:SymbolIcon Symbol="{Binding UiSymbol}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                VerticalAlignment="Top"
                                Loaded="EditingTextBox_Loaded"
                                Text="{Binding ShortValue}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.Header>
                        <TextBlock
                            Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                            Style="{StaticResource CellTextBlock}"
                            Text="按 Ctrl + Enter 複製" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CellTextBlock}" Text="{Binding ShortValue}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                VerticalAlignment="Top"
                                Loaded="EditingTextBox_Loaded"
                                Text="{Binding ShortValue}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="3*">
                    <DataGridTemplateColumn.Header>
                        <TextBlock
                            Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                            Style="{StaticResource CellTextBlock}"
                            Text="按 Enter 複製" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource CellTextBlock}" Text="{Binding LongValue}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                AcceptsTab="True"
                                Loaded="EditingTextBox_Loaded"
                                Text="{Binding LongValue}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        x:Name="DeleteItem"
                        AutomationProperties.AutomationId="QuickLookup.Context.DeleteItem"
                        Click="DeleteItem_Click"
                        Header="刪除">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="OpenInETWMenuItem"
                        AutomationProperties.AutomationId="QuickLookup.Context.OpenInEditText"
                        Click="OpenInETWMenuItem_Click"
                        Header="在文字編輯視窗中開啟">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Window24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Padding="10,4"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Style="{StaticResource CellTextBlock}">
                按 Shift + Enter 複製所有選取的資料列。
            </TextBlock>
            <TextBlock
                Grid.Column="1"
                Padding="10,4"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Style="{StaticResource CellTextBlock}">
                按 Shift + Ctrl + Enter 複製所有結果。
            </TextBlock>
            <TextBlock
                x:Name="RowCountTextBlock"
                AutomationProperties.AutomationId="QuickLookup.ResultCount"
                Grid.Column="2"
                Padding="10,4"
                HorizontalAlignment="Right"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Style="{StaticResource CellTextBlock}"
                Text="0 Rows" />
        </Grid>
        <Grid
            x:Name="ErrorBar"
            AutomationProperties.AutomationId="QuickLookup.ErrorStatus"
            Grid.Row="5"
            Background="DarkRed"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Padding="10,4"
                Foreground="White"
                Style="{StaticResource CellTextBlock}"
                Text="⚠️ 無法將文字加入剪貼簿。" />
            <ui:Button
                Name="ErrorBarOkay"
                AutomationProperties.AutomationId="QuickLookup.ErrorDismissButton"
                Grid.Column="2"
                Margin="8,4"
                Padding="12,3,12,4"
                Appearance="Primary"
                Click="ErrorBarOkay_Click"
                Content="確定" />
        </Grid>
    </Grid>
</ui:FluentWindow>
