<Page
    x:Class="Text_Grab.Pages.TesseractSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TesseractSettings"
    AutomationProperties.AutomationId="Settings.TesseractPage"
    d:DesignHeight="1450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Tesseract 設定" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Tesseract OCR" />

        <controls:SettingsCard
            Description="在支援的情況下，可從語言選擇器選取 Tesseract 語言：全螢幕擷取模式，以及從文字編輯視窗或命令列處理檔案。"
            HeaderText="在 Text Grab 中啟用 Tesseract"
            Icon="{ui:SymbolIcon PuzzlePiece24}">
            <ui:ToggleSwitch
                Name="UseTesseractCheckBox"
                AutomationProperties.AutomationId="Settings.Tesseract.EnabledToggle"
                Checked="UseTesseractCheckBox_Checked"
                Unchecked="UseTesseractCheckBox_Checked" />
        </controls:SettingsCard>
        <TextBlock
            x:Name="CouldNotFindTessTxtBlk"
            AutomationProperties.AutomationId="Settings.Tesseract.NotFoundStatus"
            Margin="1,4,0,4"
            Style="{StaticResource TextBodyNormal}"
            Text="⚠️ 找不到 Tesseract.exe"
            Visibility="Collapsed" />

        <controls:SettingsExpander
            Description="tesseract.exe 路徑。若 Tesseract 安裝於已知位置，系統會自動設定。"
            HeaderText="Tesseract 位置"
            Icon="{ui:SymbolIcon FolderOpen24}"
            IsExpanded="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="TesseractPathTextBox"
                    AutomationProperties.AutomationId="Settings.Tesseract.Path"
                    HorizontalAlignment="Stretch"
                    FontFamily="Cascadia Code"
                    TextChanged="TesseractPathTextBox_TextChanged">
                    Enter path to tesseract.exe here. ex: c:/tess/tesseract.exe
                </TextBox>
                <Button
                    x:Name="OpenPathButton"
                    AutomationProperties.AutomationId="Settings.Tesseract.OpenFolderButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Click="OpenPathButton_Click"
                    Style="{StaticResource SymbolButton}">
                    <StackPanel Margin="4,0" Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="OpenFolder24" />
                        <TextBlock Text="開啟資料夾" />
                    </StackPanel>
                </Button>
            </Grid>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Description="使用 WinGet 安裝 Tesseract，然後重新啟動 Text Grab，系統便會自動設定 Tesseract.exe 路徑。"
            HeaderText="如何取得 Tesseract？"
            Icon="{ui:SymbolIcon ArrowDownload24}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="WinGetCodeCopyButton"
                        AutomationProperties.AutomationId="Settings.Tesseract.CopyInstallCommandButton"
                        AutomationProperties.Name="複製 Tesseract 安裝指令"
                        Width="40"
                        Click="WinGetCodeCopyButton_Click"
                        Style="{StaticResource SymbolButton}">
                        <ui:SymbolIcon Symbol="Copy24" />
                    </Button>
                    <TextBox x:Name="WinGetInstallTextBox" AutomationProperties.AutomationId="Settings.Tesseract.InstallCommand" FontFamily="Cascadia Code">
                        winget install -e --id UB-Mannheim.TesseractOCR
                    </TextBox>
                </StackPanel>
                <TextBlock
                    Margin="0,4,0,8"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="安裝 Tesseract 後請重新啟動 Text Grab，系統會自動設定 Tesseract.exe 路徑。"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource TextBodyNormal}">
                    原始碼儲存庫位於 GitHub：<LineBreak />
                    <Hyperlink NavigateUri="https://github.com/tesseract-ocr/tesseract" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/tesseract-ocr/tesseract</Hyperlink>
                    <LineBreak />
                    UB Mannheim 維護了 Windows 安裝程式：<LineBreak />
                    <Hyperlink NavigateUri="https://github.com/UB-Mannheim/tesseract/wiki" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/UB-Mannheim/tesseract/wiki/</Hyperlink>
                </TextBlock>
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Description="Tesseract 的介紹、Text Grab 使用方式，以及使用它的理由。"
            HeaderText="關於 Tesseract"
            Icon="{ui:SymbolIcon QuestionCircle24}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Tesseract 是什麼？" />
                <TextBlock
                    Margin="0,2,0,10"
                    Style="{StaticResource TextBodyNormal}"
                    TextWrapping="Wrap">
                    Tesseract 是適用於多種作業系統的光學字元辨識引擎。它是以 Apache License 發行的自由軟體。最初由 Hewlett-Packard 在 1980 年代以專有軟體開發，2005 年以開放原始碼形式釋出，自 2006 年起由 Google 贊助開發。<LineBreak /><Hyperlink NavigateUri="https://en.wikipedia.org/wiki/Tesseract_(software)" RequestNavigate="Hyperlink_RequestNavigate">
                        More: https://en.wikipedia.org/wiki/Tesseract_(software)
                    </Hyperlink>
                </TextBlock>

                <TextBlock FontWeight="SemiBold" Text="Text Grab 如何使用 Tesseract？" />
                <TextBlock Margin="0,2,0,10" Style="{StaticResource TextBodyNormal}">
                    Text Grab 會擷取圖片並交由 Tesseract 執行檔處理。接著 Tesseract 會將 OCR 結果傳回 Text Grab，並依照使用者設定處理錯誤。<LineBreak />
                    不使用 Tesseract 的功能：表格辨識與擷取框。</TextBlock>

                <TextBlock FontWeight="SemiBold" Text="為什麼要使用 Tesseract？" />
                <TextBlock Margin="0,2,0,10" Style="{StaticResource TextBodyNormal}">
                    Tesseract 以出色的 OCR 能力聞名。Windows OCR 雖然方便又快速，但多年來未曾更新，Microsoft 也沒有更新計畫。<LineBreak />
                    歡迎試用 Tesseract，希望它能滿足您的需求。理想情況下，Text Grab 能結合便利性與 Tesseract 的強大功能。</TextBlock>

                <TextBlock FontWeight="SemiBold" Text="新增其他語言支援" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource TextBodyNormal}">
                    UB Mannheim 安裝的預設 OCR 模型是「快速」模型，準確度較低。您可以從此處的 tessdata GitHub 儲存庫下載更準確的模型：<LineBreak />
                    <Hyperlink NavigateUri="https://github.com/tesseract-ocr/tessdata" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/tesseract-ocr/tessdata</Hyperlink>
                    <LineBreak />
                    下載語言檔後，請將檔案放入 Tesseract 安裝位置中的「tessdata」資料夾。</TextBlock>
            </StackPanel>
        </controls:SettingsExpander>
    </StackPanel>
</Page>
