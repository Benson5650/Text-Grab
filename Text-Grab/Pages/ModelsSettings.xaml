                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid x:Name="LargeTurboMultilingualRowGrid" Margin="12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock x:Name="LargeTurboMultilingualNameText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ui:SymbolIcon
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Filled="True"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Symbol="Star24"
                                ToolTip="檔案預設"
                                Visibility="{Binding IsSelected, ElementName=LargeTurboMultilingualComboBoxItem, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="LargeTurboMultilingualLanguageText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="LargeTurboMultilingualStatusText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="LargeTurboMultilingualDownloadButton"
                                AutomationProperties.AutomationId="Settings.Models.LargeTurboMultilingual.Download"
                                Click="DownloadButton_Click"
                                Style="{StaticResource SymbolButton}"
                                Tag="LargeTurboMultilingual"
                                ToolTip="下載">
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </Button>
                            <Button
                                x:Name="LargeTurboMultilingualDeleteButton"
