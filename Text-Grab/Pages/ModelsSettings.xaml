                                Click="DeleteButton_Click"
                                Style="{StaticResource SymbolButton}"
                                Tag="LargeTurboMultilingual"
                                ToolTip="刪除">
                                <ui:SymbolIcon Symbol="Delete24" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid x:Name="LargeMultilingualRowGrid" Margin="12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock x:Name="LargeMultilingualNameText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ui:SymbolIcon
