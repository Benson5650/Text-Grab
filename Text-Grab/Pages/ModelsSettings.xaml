                                Style="{StaticResource SymbolButton}"
                                Tag="MediumEnglish"
                                ToolTip="刪除">
                                <ui:SymbolIcon Symbol="Delete24" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid x:Name="MediumMultilingualRowGrid" Margin="12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock x:Name="MediumMultilingualNameText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ui:SymbolIcon
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Filled="True"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Symbol="Star24"
                                ToolTip="檔案預設"
                                Visibility="{Binding IsSelected, ElementName=MediumMultilingualComboBoxItem, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="MediumMultilingualLanguageText"
