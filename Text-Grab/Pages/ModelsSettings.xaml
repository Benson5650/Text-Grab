<Page
    x:Class="Text_Grab.Pages.ModelsSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ModelsSettings"
    d:DesignHeight="1100"
    d:DesignWidth="800"
    AutomationProperties.AutomationId="Settings.ModelsPage"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="模型設定" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="語音轉文字 (Whisper)" />
        <TextBlock
            Margin="1,0,0,10"
            Style="{StaticResource TextBodyNormal}"
            TextWrapping="Wrap">
            音訊轉錄全程在此裝置上使用本機 Whisper 模型執行。模型首次使用時會下載至磁碟；您可以在此選擇預設模型、預先下載模型，或刪除模型以釋出空間。
        </TextBlock>

        <controls:SettingsExpander
            Description="轉錄音訊或影片檔案時使用的預設模型；個別轉錄工作可另行變更。"
            HeaderText="檔案轉錄預設模型"
            Icon="{ui:SymbolIcon DocumentCatchUp20}"
            IsExpanded="True">
            <ComboBox
                x:Name="DefaultModelComboBox"
                Width="320"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="Settings.Models.DefaultModel"
                SelectionChanged="DefaultModelComboBox_SelectionChanged">
                <ComboBoxItem x:Name="TinyEnglishComboBoxItem" Tag="TinyEnglish" />
                <ComboBoxItem x:Name="BaseEnglishComboBoxItem" Tag="BaseEnglish" />
                <ComboBoxItem x:Name="BaseMultilingualComboBoxItem" Tag="BaseMultilingual" />
                <ComboBoxItem x:Name="SmallMultilingualComboBoxItem" Tag="SmallMultilingual" />
                <ComboBoxItem x:Name="MediumEnglishComboBoxItem" Tag="MediumEnglish" />
                <ComboBoxItem x:Name="MediumMultilingualComboBoxItem" Tag="MediumMultilingual" />
                <ComboBoxItem x:Name="LargeTurboMultilingualComboBoxItem" Tag="LargeTurboMultilingual" />
                <ComboBoxItem x:Name="LargeMultilingualComboBoxItem" Tag="LargeMultilingual" />
            </ComboBox>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Margin="0,4,0,0"
            Description="從麥克風或系統音訊進行即時（近乎即時）轉錄時使用的預設模型。僅提供較小且快速的模型，以跟上語音速度；也可在轉錄按鈕的右鍵選單中變更。"
            HeaderText="即時轉錄預設模型"
            Icon="{ui:SymbolIcon MicPulse24}"
            IsExpanded="True">
            <ComboBox
                x:Name="LiveDefaultModelComboBox"
                Width="320"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="Settings.Models.LiveDefaultModel"
                SelectionChanged="LiveDefaultModelComboBox_SelectionChanged">
                <ComboBoxItem x:Name="TinyEnglishLiveComboBoxItem" Tag="TinyEnglish" />
                <ComboBoxItem x:Name="BaseEnglishLiveComboBoxItem" Tag="BaseEnglish" />
                <ComboBoxItem x:Name="BaseMultilingualLiveComboBoxItem" Tag="BaseMultilingual" />
                <ComboBoxItem x:Name="SmallMultilingualLiveComboBoxItem" Tag="SmallMultilingual" />
            </ComboBox>
        </controls:SettingsExpander>

        <Border
            Margin="0,4,0,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <Grid Margin="12,7,12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="模型" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="語言" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="狀態" />
                </Grid>

                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid x:Name="TinyEnglishRowGrid" Margin="12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock x:Name="TinyEnglishNameText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ui:SymbolIcon
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Filled="True"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Symbol="Star24"
                                ToolTip="檔案預設"
                                Visibility="{Binding IsSelected, ElementName=TinyEnglishComboBoxItem, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Filled="True"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Symbol="MicPulse24"
                                ToolTip="即時預設"
                                Visibility="{Binding IsSelected, ElementName=TinyEnglishLiveComboBoxItem, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TinyEnglishLanguageText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="TinyEnglishStatusText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="TinyEnglishDownloadButton"
                                AutomationProperties.AutomationId="Settings.Models.TinyEnglish.Download"
                                Click="DownloadButton_Click"
                                Style="{StaticResource SymbolButton}"
                                Tag="TinyEnglish"
                                ToolTip="下載">
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </Button>
                            <Button
                                x:Name="TinyEnglishDeleteButton"
                                AutomationProperties.AutomationId="Settings.Models.TinyEnglish.Delete"
                                Click="DeleteButton_Click"
                                Style="{StaticResource SymbolButton}"
                                Tag="TinyEnglish"
                                ToolTip="刪除">
                                <ui:SymbolIcon Symbol="Delete24" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
