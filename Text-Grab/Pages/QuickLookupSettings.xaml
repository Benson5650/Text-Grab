<Page
    x:Class="Text_Grab.Pages.QuickLookupSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="QuickLookupSettings"
    AutomationProperties.AutomationId="Settings.QuickLookupPage"
    d:DesignHeight="500"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="快速查詢設定" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="查詢檔案" />

        <controls:SettingsExpander
            Description="CSV 檔案路徑，檔案需包含 ShortValue 與 LongValue 欄。留空則使用應用程式所在資料夾中的預設快取檔。"
            HeaderText="查詢檔案位置"
            Icon="{ui:SymbolIcon DocumentTable24}"
            IsExpanded="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="LookupFileLocationTextBox"
                    AutomationProperties.AutomationId="Settings.QuickLookup.FileLocation"
                    HorizontalAlignment="Stretch"
                    LostFocus="LookupFileLocationTextBox_LostFocus" />
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Click="BrowseLookupFileButton_Click"
                    Content="瀏覽…"
                    AutomationProperties.AutomationId="Settings.QuickLookup.BrowseFileButton" />
            </Grid>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="行為" />

        <controls:SettingsCard
            Description="將近期文字編輯視窗工作階段與擷取框擷取結果附加至查詢表格底部。"
            HeaderText="在查詢表格中顯示歷史記錄"
            Icon="{ui:SymbolIcon History24}">
            <ui:ToggleSwitch x:Name="LookupSearchHistoryCheckBox" AutomationProperties.AutomationId="Settings.QuickLookup.SearchHistoryToggle" Click="LookupSearchHistoryCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="按 Enter 選取後，關閉快速查詢並將內容貼到先前作用中的應用程式。"
            HeaderText="將選取的值貼到先前作用中的應用程式"
            Icon="{ui:SymbolIcon ClipboardPaste24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch x:Name="TryInsertCheckBox" AutomationProperties.AutomationId="Settings.QuickLookup.InsertToggle" Click="TryInsertCheckBox_Click" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="插入延遲（秒）：" />
                    <Slider
                        x:Name="InsertDelaySlider"
                        AutomationProperties.AutomationId="Settings.QuickLookup.InsertDelay"
                        Width="200"
                        Margin="12,0,0,0"
                        IsSnapToTickEnabled="True"
                        Maximum="5"
                        Minimum="0"
                        SmallChange="0.1"
                        TickFrequency="0.1"
                        ValueChanged="InsertDelaySlider_ValueChanged" />
                    <TextBlock
                        x:Name="InsertDelayValueText"
                        AutomationProperties.AutomationId="Settings.QuickLookup.InsertDelayValue"
                        Width="40"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="快速查詢會在此延遲時間後，對先前作用中的應用程式送出 Ctrl+V，讓您有時間切換視窗。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

    </StackPanel>
</Page>
