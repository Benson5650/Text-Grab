<Page
    x:Class="Text_Grab.Pages.KeysSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="KeysSettings"
    AutomationProperties.AutomationId="Settings.ShortcutsPage"
    d:DesignHeight="1450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="快捷鍵設定" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="背景執行與快速鍵" />

        <controls:SettingsCard
            Description="此設定必須在關閉所有 Text Grab 執行個體後才會生效。"
            HeaderText="在背景執行 Text Grab 並啟用快速鍵"
            Icon="{ui:SymbolIcon Desktop24}">
            <ui:ToggleSwitch
                Name="RunInBackgroundChkBx"
                AutomationProperties.AutomationId="Settings.Shortcuts.BackgroundToggle"
                Checked="RunInBackgroundChkBx_Checked"
                Unchecked="RunInBackgroundChkBx_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="使用下列快捷鍵，即可隨時啟動 Text Grab。"
            HeaderText="全域快速鍵"
            Icon="{ui:SymbolIcon Keyboard24}">
            <ui:ToggleSwitch
                x:Name="GlobalHotkeysCheckbox"
                AutomationProperties.AutomationId="Settings.Shortcuts.GlobalHotkeysToggle"
                Checked="GlobalHotkeysCheckbox_Checked"
                IsEnabled="{Binding IsChecked, ElementName=RunInBackgroundChkBx, Mode=OneWay}"
                Unchecked="GlobalHotkeysCheckbox_Unchecked" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="快捷鍵" />

        <StackPanel
            x:Name="ShortcutsStackPanel"
            AutomationProperties.AutomationId="Settings.Shortcuts.List"
            IsEnabled="{Binding IsChecked, ElementName=GlobalHotkeysCheckbox, Mode=OneWay}"
            Orientation="Vertical">
            <controls:ShortcutControl
                x:Name="FsgShortcutControl"
                AutomationProperties.AutomationId="Settings.Shortcuts.FullscreenGrab"
                IsShortcutEnabled="True"
                KeySetChanged="ShortcutControl_KeySetChanged"
                RecordingStarted="ShortcutControl_Recording"
                ShortcutName="全螢幕擷取" />
            <controls:ShortcutControl
                x:Name="GlrShortcutControl"
                AutomationProperties.AutomationId="Settings.Shortcuts.LastRegion"
                KeySetChanged="ShortcutControl_KeySetChanged"
                RecordingStarted="ShortcutControl_Recording"
                ShortcutName="擷取上一個區域" />
            <controls:ShortcutControl
                x:Name="GfShortcutControl"
                AutomationProperties.AutomationId="Settings.Shortcuts.GrabFrame"
                KeySetChanged="ShortcutControl_KeySetChanged"
                RecordingStarted="ShortcutControl_Recording"
                ShortcutName="擷取框" />
            <controls:ShortcutControl
                x:Name="LgfShortcutControl"
                AutomationProperties.AutomationId="Settings.Shortcuts.LastGrabFrame"
                KeySetChanged="ShortcutControl_KeySetChanged"
                RecordingStarted="ShortcutControl_Recording"
                ShortcutName="開啟上一個擷取框" />
            <controls:ShortcutControl
                x:Name="EtwShortcutControl"
                AutomationProperties.AutomationId="Settings.Shortcuts.EditText"
                KeySetChanged="ShortcutControl_KeySetChanged"
                RecordingStarted="ShortcutControl_Recording"
                ShortcutName="文字編輯視窗" />
            <controls:ShortcutControl
                x:Name="LetwShortcutControl"
                AutomationProperties.AutomationId="Settings.Shortcuts.LastEditText"
                KeySetChanged="ShortcutControl_KeySetChanged"
                RecordingStarted="ShortcutControl_Recording"
                ShortcutName="上一個文字編輯視窗" />
            <controls:ShortcutControl
                x:Name="QslShortcutControl"
                AutomationProperties.AutomationId="Settings.Shortcuts.QuickLookup"
                KeySetChanged="ShortcutControl_KeySetChanged"
                RecordingStarted="ShortcutControl_Recording"
                ShortcutName="快速查詢" />
            <controls:ShortcutControl
                x:Name="OccShortcutControl"
                AutomationProperties.AutomationId="Settings.Shortcuts.ClipboardContent"
                KeySetChanged="ShortcutControl_KeySetChanged"
                RecordingStarted="ShortcutControl_Recording"
                ShortcutName="開啟剪貼簿內容" />
        </StackPanel>
    </StackPanel>
</Page>
