<Page
    x:Class="Text_Grab.Pages.VoiceOutputSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="VoiceOutputSettings"
    AutomationProperties.AutomationId="Settings.VoiceOutputPage"
    d:DesignHeight="700"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="20,12,24,40" Orientation="Vertical">
            <TextBlock Style="{StaticResource SettingsPageTitle}" Text="語音輸出設定" />

            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="語音" />

            <controls:SettingsCard
                Description="從此裝置已安裝的語音中選擇。"
                HeaderText="語音"
                Icon="{ui:SymbolIcon PersonVoice24}">
                <ComboBox
                    x:Name="VoiceComboBox"
                    AutomationProperties.AutomationId="Settings.VoiceOutput.Voice"
                    Width="260"
                    SelectionChanged="VoiceComboBox_SelectionChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="語音播放速度；預設值為 1.0。"
                HeaderText="語速"
                Icon="{ui:SymbolIcon TopSpeed24}">
                <StackPanel Orientation="Horizontal">
                    <Slider
                        x:Name="SpeakingRateSlider"
                        AutomationProperties.AutomationId="Settings.VoiceOutput.Rate"
                        Width="200"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="4.0"
                        Minimum="0.5"
                        TickFrequency="0.1"
                        ValueChanged="SpeakingRateSlider_ValueChanged" />
                    <TextBlock
                        x:Name="SpeakingRateValue"
                        AutomationProperties.AutomationId="Settings.VoiceOutput.RateValue"
                        Width="32"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="朗讀到指定字數後停止。設為 0 表示不限制。"
                HeaderText="字數上限"
                Icon="{ui:SymbolIcon NumberSymbol24}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        x:Name="TtsWordLimitError"
                        AutomationProperties.AutomationId="Settings.VoiceOutput.WordLimitError"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Text="⚠ 必須是正數"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="TtsSpeakWordLimitTextBox"
                        AutomationProperties.AutomationId="Settings.VoiceOutput.WordLimit"
                        Width="60"
                        Height="26"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="White"
                        FontWeight="Medium"
                        Foreground="Black"
                        Style="{StaticResource TextBoxStyle1}"
                        TextChanged="TtsSpeakWordLimitTextBox_TextChanged" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="耗時作業（例如 AI 圖片描述）仍在處理時，播放簡短的語音提示。"
                HeaderText="耗時作業處理中時發出語音提示"
                Icon="{ui:SymbolIcon ReadAloud24}">
                <ui:ToggleSwitch
                    x:Name="SpeakProcessingStatusCheckBox"
                    AutomationProperties.AutomationId="Settings.VoiceOutput.ProcessingAnnouncementToggle"
                    Checked="SpeakProcessingStatusCheckBox_CheckChanged"
                    Unchecked="SpeakProcessingStatusCheckBox_CheckChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="聆聽使用目前語音與語速朗讀的範例句子。"
                HeaderText="Preview"
                Icon="{ui:SymbolIcon Play24}">
                <Button
                    x:Name="PreviewVoiceButton"
                    AutomationProperties.AutomationId="Settings.VoiceOutput.PreviewButton"
                    Click="PreviewVoiceButton_Click"
                    Content="播放語音範例" />
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
