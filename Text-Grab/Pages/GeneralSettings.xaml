<Page
    x:Class="Text_Grab.Pages.GeneralSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Text_Grab.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GeneralSettings"
    d:DesignHeight="1450"
    d:DesignWidth="800"
    AutomationProperties.AutomationId="Settings.GeneralPage"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="一般設定" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <!--  Version Text  -->
            <TextBlock
                x:Name="VersionTextblock"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Settings.General.Version"
                Style="{StaticResource TextBodyNormal}"
                Text="版本 X.X" />

            <ui:HyperlinkButton
                x:Name="OpenExeFolderButton"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Bottom"
                Click="OpenExeFolderButton_Click"
                Foreground="{StaticResource Teal}"
                Visibility="Collapsed">
                <TextBlock Text="開啟 EXE 所在資料夾" />
            </ui:HyperlinkButton>

            <controls:CollapsibleButton
                x:Name="AboutBTN"
                Grid.Column="3"
                Margin="0"
                AutomationProperties.AutomationId="Settings.General.AboutButton"
                ButtonSymbol="Info24"
                ButtonText="關於 Text Grab"
                Click="AboutBTN_Click" />
        </Grid>

        <Border
            Margin="0,20"
            Padding="20,12,20,20"
            Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="8">
            <StackPanel Orientation="Vertical">
                <TextBlock Style="{StaticResource TextHeader}" Text="你好！" />
                <TextBlock Style="{StaticResource TextBodyNormal}">
                    感謝您使用 Text Grab！

打造這個應用程式是出於熱愛。我一直很樂意聽取使用者的想法，了解您如何使用這款應用程式，以及未來希望看到哪些功能。<LineBreak />
                    如果您遇到錯誤或有功能建議，歡迎在 GitHub 提出問題。若有疑問或只是想打聲招呼，也可以直接寄電子郵件給我。<LineBreak />
                    祝您擷取愉快！</TextBlock>
                <TextBlock
                    Margin="0,12"
                    HorizontalAlignment="Left"
                    Style="{StaticResource TextBodyNormal}"
                    Text="- Joe" />
                <ui:HyperlinkButton Foreground="{StaticResource Teal}" NavigateUri="https://github.com/TheJoeFin/Text-Grab/issues">
                    🌐 https://github.com/TheJoeFin/Text-Grab/issues
                </ui:HyperlinkButton>
                <ui:HyperlinkButton Foreground="{StaticResource Teal}" NavigateUri="mailto:joe@JoeFinApps.com">
                    📧 joe@JoeFinApps.com
                </ui:HyperlinkButton>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="外觀" />

        <controls:SettingsExpander
            Description="選擇 Text Grab 是否跟隨 Windows 佈景主題，或一律使用淺色/深色模式。"
            HeaderText="Text Grab 佈景主題"
            Icon="{ui:SymbolIcon Color24}">
            <StackPanel>
                <RadioButton
                    x:Name="SystemThemeRdBtn"
                    AutomationProperties.AutomationId="Settings.General.Theme.System"
                    Checked="SystemThemeRdBtn_Checked"
                    Content="系統"
                    GroupName="ThemeGroup" />
                <RadioButton
                    x:Name="LightThemeRdBtn"
                    AutomationProperties.AutomationId="Settings.General.Theme.Light"
                    Checked="LightThemeRdBtn_Checked"
                    Content="淺色"
                    GroupName="ThemeGroup" />
                <RadioButton
                    x:Name="DarkThemeRdBtn"
                    AutomationProperties.AutomationId="Settings.General.Theme.Dark"
                    Checked="DarkThemeRdBtn_Checked"
                    Content="深色"
                    GroupName="ThemeGroup" />
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Description="選擇系統匣圖示使用全彩，或採用會跟隨工作列佈景主題的單色外框。"
            HeaderText="系統匣圖示樣式"
            Icon="{ui:SymbolIcon PaintBucket24}">
            <StackPanel>
                <RadioButton
                    x:Name="ColorTrayIconRdBtn"
                    AutomationProperties.AutomationId="Settings.General.TrayIconStyle.Color"
                    Checked="ColorTrayIconRdBtn_Checked"
                    Content="彩色"
                    GroupName="TrayIconStyleGroup" />
                <RadioButton
                    x:Name="MonochromeTrayIconRdBtn"
                    AutomationProperties.AutomationId="Settings.General.TrayIconStyle.Monochrome"
                    Checked="MonochromeTrayIconRdBtn_Checked"
                    Content="單色"
                    GroupName="TrayIconStyleGroup" />
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Description="選擇 Text Grab 使用顯示卡或 CPU 繪製視窗。變更後請重新啟動 Text Grab 才會生效。"
            HeaderText="繪製方式"
            Icon="{ui:SymbolIcon DeveloperBoard24}">
            <StackPanel>
                <RadioButton
                    x:Name="RenderingAutoRadio"
                    AutomationProperties.AutomationId="Settings.General.Rendering.Auto"
                    Checked="RenderingModeRadio_Checked"
                    Content="自動"
                    GroupName="RenderingModeGroup"
                    Tag="Auto" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="在 Arm64 裝置上使用 CPU，避免顯示卡驅動程式占用約 1 GB 記憶體；其他裝置則使用顯示卡。"
                    TextWrapping="Wrap" />

                <RadioButton
                    x:Name="RenderingHardwareRadio"
                    AutomationProperties.AutomationId="Settings.General.Rendering.Hardware"
                    Checked="RenderingModeRadio_Checked"
                    Content="顯示卡"
                    GroupName="RenderingModeGroup"
                    Tag="Hardware" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="一律使用顯示卡繪製。部分裝置會因此使用較多記憶體。"
                    TextWrapping="Wrap" />

                <RadioButton
                    x:Name="RenderingSoftwareRadio"
                    AutomationProperties.AutomationId="Settings.General.Rendering.Software"
                    Checked="RenderingModeRadio_Checked"
                    Content="CPU（軟體）"
                    GroupName="RenderingModeGroup"
                    Tag="Software" />
                <TextBlock
                    Margin="24,0,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="一律使用 CPU 繪製，可大幅減少顯示記憶體用量。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="行為" />

        <controls:SettingsCard
            Description="按一下通知會在新的文字編輯視窗中開啟已複製的文字，以供檢視與編輯。"
            HeaderText="複製文字時顯示通知"
            Icon="{ui:SymbolIcon Alert24}">
            <ui:ToggleSwitch
                Name="ShowToastCheckBox"
                AutomationProperties.AutomationId="Settings.General.NotificationsToggle"
                Checked="ShowToastCheckBox_Checked"
                Unchecked="ShowToastCheckBox_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="啟動 Text Grab 時要開啟的視窗。"
            HeaderText="預設啟動視窗"
            Icon="{ui:SymbolIcon AppFolder24}">
            <StackPanel>
                <RadioButton
                    x:Name="FullScreenRDBTN"
                    AutomationProperties.AutomationId="Settings.General.DefaultLaunch.Fullscreen"
                    Checked="FullScreenRDBTN_Checked"
                    GroupName="DefaultLaunch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="SlideAdd20" />
                        <TextBlock VerticalAlignment="Center" Text="全螢幕擷取" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="GrabFrameRDBTN"
                    AutomationProperties.AutomationId="Settings.General.DefaultLaunch.GrabFrame"
                    Checked="GrabFrameRDBTN_Checked"
                    GroupName="DefaultLaunch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="PanelBottom20" />
                        <TextBlock VerticalAlignment="Center" Text="擷取框" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="EditTextRDBTN"
                    AutomationProperties.AutomationId="Settings.General.DefaultLaunch.EditText"
                    Checked="EditTextRDBTN_Checked"
                    GroupName="DefaultLaunch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="Window20" />
                        <TextBlock VerticalAlignment="Center" Text="文字編輯視窗" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="QuickLookupRDBTN"
                    AutomationProperties.AutomationId="Settings.General.DefaultLaunch.QuickLookup"
                    Checked="QuickLookupRDBTN_Checked"
                    GroupName="DefaultLaunch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="SlideSearch20" />
                        <TextBlock VerticalAlignment="Center" Text="快速查詢" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsCard
            Description="在背景執行 Text Grab 並啟用快速鍵。"
            HeaderText="在背景執行"
            Icon="{ui:SymbolIcon Desktop24}">
            <ui:ToggleSwitch
                Name="RunInBackgroundChkBx"
                AutomationProperties.AutomationId="Settings.General.BackgroundToggle"
                Checked="RunInBackgroundChkBx_Checked"
                Unchecked="RunInBackgroundChkBx_Checked" />
        </controls:SettingsCard>

        <controls:SettingsCard HeaderText="登入時自動啟動 Text Grab" Icon="{ui:SymbolIcon Power24}">
            <ui:ToggleSwitch
                Name="StartupOnLoginCheckBox"
                AutomationProperties.AutomationId="Settings.General.StartupToggle"
                Checked="StartupOnLoginCheckBox_Checked"
                Unchecked="StartupOnLoginCheckBox_Unchecked" />
        </controls:SettingsCard>
        <TextBlock
            x:Name="StartupTextBlock"
            Margin="1,0,0,8"
            AutomationProperties.AutomationId="Settings.General.StartupStatus"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="整合" />

        <controls:SettingsCard
            Description="在支援的圖片或 PDF 檔案上按右鍵，即可快速擷取文字。"
            HeaderText="Add &quot;Grab text with Text Grab&quot; to the right-click menu"
            Icon="{ui:SymbolIcon CursorClick24}">
            <ui:ToggleSwitch
                Name="AddToContextMenuCheckBox"
                AutomationProperties.AutomationId="Settings.General.ContextMenuToggle"
                Checked="AddToContextMenuCheckBox_Checked"
                Unchecked="AddToContextMenuCheckBox_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="在檔案總管使用「開啟檔案」時，會直接在擷取框中開啟支援的圖片與 PDF。"
            HeaderText="Register Text Grab as an &quot;Open with&quot; app for image and PDF files"
            Icon="{ui:SymbolIcon Open24}">
            <ui:ToggleSwitch
                Name="RegisterOpenWithCheckBox"
                AutomationProperties.AutomationId="Settings.General.OpenWithToggle"
                Checked="RegisterOpenWithCheckBox_Checked"
                Unchecked="RegisterOpenWithCheckBox_Unchecked" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="擷取" />

        <controls:SettingsCard
            Description="擷取時嘗試辨識條碼與 QR 碼。停用此功能可能加快處理速度。"
            HeaderText="辨識條碼與 QR 碼"
            Icon="{ui:SymbolIcon BarcodeScanner24}">
            <ui:ToggleSwitch
                Name="ReadBarcodesBarcode"
                AutomationProperties.AutomationId="Settings.General.ReadBarcodesToggle"
                Checked="ReadBarcodesBarcode_Checked"
                Unchecked="ReadBarcodesBarcode_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="以完整色域擷取 HDR 螢幕，再轉換為 SDR，避免文字過亮。僅適用於已開啟 HDR 的螢幕。"
            HeaderText="修正 HDR 螢幕上的擷取畫面褪色問題"
            Icon="{ui:SymbolIcon Hdr24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch
                    Name="HdrCaptureCorrectionToggle"
                    AutomationProperties.AutomationId="Settings.General.HdrCorrectionToggle"
                    Checked="HdrCaptureCorrectionToggle_Checked"
                    Unchecked="HdrCaptureCorrectionToggle_Unchecked" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel>
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="移除黃色擷取邊框需要 Windows「無邊框擷取」權限。請使用「檢查權限」授予權限。"
                    TextWrapping="Wrap" />
                <ui:Button
                    Name="CheckHdrPermissionButton"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="Settings.General.CheckHdrPermissionButton"
                    Click="CheckHdrPermissionButton_Click"
                    Content="檢查權限" />
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsCard HeaderText="網頁搜尋引擎" Icon="{ui:SymbolIcon Search24}">
            <ComboBox
                x:Name="WebSearchersComboBox"
                Width="240"
                AutomationProperties.AutomationId="Settings.General.WebSearchEngine"
                IsTextSearchCaseSensitive="False"
                SelectionChanged="WebSearchersComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="修正常見辨識錯誤" />

        <controls:SettingsCard HeaderText="Detect paragraph wrapping — join wrapped lines into one paragraph" Icon="{ui:SymbolIcon TextParagraph24}">
            <ui:ToggleSwitch
                Name="ParagraphDetectionToggle"
                AutomationProperties.AutomationId="Settings.General.ParagraphDetectionToggle"
                Checked="ParagraphDetectionToggle_Checked"
                Unchecked="ParagraphDetectionToggle_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsCard HeaderText="修正容易混淆的數字與字母" Icon="{ui:SymbolIcon Wand24}">
            <ui:ToggleSwitch
                Name="ErrorCorrectBox"
                AutomationProperties.AutomationId="Settings.General.ErrorCorrectionToggle"
                Checked="ErrorCorrectBox_Checked"
                Unchecked="ErrorCorrectBox_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsCard HeaderText="修正希臘字母、西里爾字母與拉丁字母之間的誤辨" Icon="{ui:SymbolIcon TextT24}">
            <ui:ToggleSwitch
                Name="CorrectToLatin"
                AutomationProperties.AutomationId="Settings.General.CorrectToLatinToggle"
                Checked="CorrectToLatin_Checked"
                Unchecked="CorrectToLatin_Unchecked" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="剪貼簿" />

        <controls:SettingsCard HeaderText="不要自動將文字加入剪貼簿" Icon="{ui:SymbolIcon ClipboardLetter24}">
            <ui:ToggleSwitch
                Name="NeverUseClipboardChkBx"
                AutomationProperties.AutomationId="Settings.General.DisableClipboardToggle"
                Checked="NeverUseClipboardChkBx_Checked"
                Unchecked="NeverUseClipboardChkBx_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="全螢幕擷取後，等待一段時間，再將擷取文字貼到目前作用中的文字欄位。"
            HeaderText="全螢幕擷取後，嘗試將文字輸入文字欄位"
            Icon="{ui:SymbolIcon ClipboardPaste24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch
                    Name="TryInsertCheckbox"
                    AutomationProperties.AutomationId="Settings.General.InsertAfterCaptureToggle"
                    Checked="TryInsertCheckbox_Checked"
                    Unchecked="TryInsertCheckbox_Unchecked" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="延遲後插入" />
                <TextBox
                    x:Name="SecondsTextBox"
                    Width="40"
                    Height="26"
                    Margin="8,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    AutomationProperties.AutomationId="Settings.General.InsertDelay"
                    Background="White"
                    FontWeight="Medium"
                    Foreground="Black"
                    Style="{StaticResource TextBoxStyle1}"
                    Text="0.5"
                    TextChanged="ValidateTextIsNumber" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="秒" />
                <TextBlock
                    x:Name="DelayTimeErrorSeconds"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Settings.General.InsertDelayError"
                    Text="⚠ 請輸入 0 到 10 之間的數字"
                    Visibility="Collapsed" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="歷史記錄" />

        <controls:SettingsCard
            Description="保留擷取與文字編輯視窗的近期歷史記錄。"
            HeaderText="保留歷史記錄"
            Icon="{ui:SymbolIcon History24}">
            <ui:ToggleSwitch
                Name="HistorySwitch"
                AutomationProperties.AutomationId="Settings.General.HistoryToggle"
                Checked="HistorySwitch_Checked"
                Unchecked="HistorySwitch_Unchecked" />
        </controls:SettingsCard>

    </StackPanel>
</Page>
