<ui:FluentWindow
    x:Class="Text_Grab.Controls.PostGrabActionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="擷取後動作設定"
    AutomationProperties.AutomationId="PostGrabActionsDialog"
    Width="900"
    Height="700"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />

        <!--  Converter to convert enum to int for ComboBox SelectedIndex  -->
        <local:EnumToIntConverter x:Key="EnumToIntConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" MaxHeight="400" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="擷取後動作設定"
            Grid.ColumnSpan="3"
            Height="32"
            Margin="2,2,2,0"
            Padding="8,2"
            Icon="{StaticResource TextGrabIcon}" />

        <!--  Available Actions (Left)  -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Margin="16,16,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,8"
                FontSize="18"
                FontWeight="SemiBold"
                Text="可用動作" />
            <TextBlock
                x:Name="AvailableActionsHint"
                Grid.Row="1"
                Margin="0,0,0,4"
                Opacity="0.7"
                Text="可新增至已啟用清單的動作"
                TextWrapping="Wrap" />
            <Border
                Grid.Row="2"
                Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <ui:ListView
                        x:Name="AvailableActionsListBox"
                        AutomationProperties.AutomationId="PostGrabActions.AvailableList"
                        d:ItemsSource="{d:SampleData ItemCount=5}"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="346"
                                    DisplayMemberBinding="{Binding DisplayText}"
                                    Header="動作名稱" />
                            </GridView>
                        </ListView.View>
                    </ui:ListView>
                    <TextBlock
                        x:Name="NoAvailableActionsText"
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Opacity="0.6"
                        Text="目前已啟用所有動作"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!--  Move Buttons (Center)  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="8"
            VerticalAlignment="Center">
            <ui:Button
                x:Name="AddButton"
                AutomationProperties.AutomationId="PostGrabActions.AddButton"
                Width="100"
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                Click="AddButton_Click"
                ToolTip="將選取的動作新增至已啟用清單">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowRight16" />
                    <TextBlock Margin="4,0,0,0" Text="新增" />
                </StackPanel>
            </ui:Button>
            <ui:Button
                x:Name="RemoveButton"
                AutomationProperties.AutomationId="PostGrabActions.RemoveButton"
                Width="100"
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                Click="RemoveButton_Click"
                ToolTip="從已啟用清單移除選取的動作">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowLeft16" />
                    <TextBlock Margin="4,0,0,0" Text="移除" />
                </StackPanel>
            </ui:Button>
            <Separator Margin="0,8" />
            <ui:Button
                x:Name="MoveUpButton"
                AutomationProperties.AutomationId="PostGrabActions.MoveUpButton"
                Width="100"
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                Click="MoveUpButton_Click"
                ToolTip="將選取的動作上移">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowUp16" />
                    <TextBlock Margin="4,0,0,0" Text="上移" />
                </StackPanel>
            </ui:Button>
            <ui:Button
                x:Name="MoveDownButton"
                AutomationProperties.AutomationId="PostGrabActions.MoveDownButton"
                Width="100"
                HorizontalAlignment="Center"
                Click="MoveDownButton_Click"
                ToolTip="將選取的動作下移">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="14" Symbol="ArrowDown16" />
                    <TextBlock Margin="4,0,0,0" Text="下移" />
                </StackPanel>
            </ui:Button>
        </StackPanel>

        <!--  Enabled Actions (Right)  -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid Margin="8,16,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="已啟用的動作" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,0,4"
                    Opacity="0.7"
                    Text="會顯示在擷取後動作選單中的動作"
                    TextWrapping="Wrap" />
                <Border
                    Grid.Row="2"
                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ui:ListView
                        x:Name="EnabledActionsListBox"
                        AutomationProperties.AutomationId="PostGrabActions.EnabledList"
                        d:ItemsSource="{d:SampleData ItemCount=5}"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="226"
                                    DisplayMemberBinding="{Binding DisplayText}"
                                    Header="動作名稱" />
                                <GridViewColumn Width="120" Header="預設">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Width="110" SelectedIndex="{Binding Path=DefaultCheckState, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                                <ComboBoxItem Content="關閉" />
                                                <ComboBoxItem Content="上次使用" />
                                                <ComboBoxItem Content="開啟" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ui:ListView>
                </Border>

                <!--  Stay Open Toggle  -->
                <ui:ToggleSwitch
                    x:Name="StayOpenToggle"
                    AutomationProperties.AutomationId="PostGrabActions.StayOpenToggle"
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    Content="按下動作後保持選單開啟"
                    ToolTip="啟用後，按下動作時擷取後動作選單會保持開啟，方便選取多個動作" />
            </Grid>
        </Grid>

        <!--  Grab Templates Section  -->
        <Border
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="16,0,16,8"
            Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Margin="12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header + buttons  -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="擷取範本" />
                            <Button
                                x:Name="TemplateInfoButton"
                                Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="TemplateInfoButton_Click"
                                ToolTip="關於擷取範本">
                                <ui:SymbolIcon FontSize="14" Symbol="Info24" />
                            </Button>
                            <Popup
                                x:Name="TemplateInfoPopup"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=TemplateInfoButton}"
                                StaysOpen="False">
                                <Border
                                    Padding="12"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <TextBlock
                                        MaxWidth="360"
                                        FontSize="12"
                                        Text="範本可從固定版面的文件擷取結構化資料。按一下「從影像新增範本」選取參考影像，再按住 Ctrl 並拖曳以繪製區域並儲存。將範本加入「已啟用的動作」清單，即可在全螢幕擷取時使用。"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            x:Name="NewTemplateFromImageButton"
                            AutomationProperties.AutomationId="PostGrabActions.NewImageTemplateButton"
                            Margin="0,0,6,0"
                            Click="NewTemplateFromImageButton_Click"
                            ToolTip="選取影像作為新擷取範本的參考">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="14" Symbol="ImageAdd24" />
                                <TextBlock Margin="4,0,0,0" Text="從影像新增" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button
                            x:Name="NewTextOnlyTemplateButton"
                            AutomationProperties.AutomationId="PostGrabActions.NewTextTemplateButton"
                            Margin="0,0,6,0"
                            Click="NewTextOnlyTemplateButton_Click"
                            ToolTip="不使用參考影像，建立含名稱與輸出範本的新範本">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="14" Symbol="Add24" />
                                <TextBlock Margin="4,0,0,0" Text="新增純文字範本" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button
                            x:Name="EditTemplateRegionsButton"
                            AutomationProperties.AutomationId="PostGrabActions.EditTemplateButton"
                            Margin="0,0,6,0"
                            Click="EditTemplateRegionsButton_Click"
                            ToolTip="在擷取框中開啟選取的範本並編輯區域">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="14" Symbol="Edit24" />
                                <TextBlock Margin="4,0,0,0" Text="編輯擷取範本" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button
                            x:Name="DeleteTemplateButton"
                            AutomationProperties.AutomationId="PostGrabActions.DeleteTemplateButton"
                            Click="DeleteTemplateButton_Click"
                            ToolTip="刪除選取的擷取範本">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="14" Symbol="Delete24" />
                                <TextBlock Margin="4,0,0,0" Text="刪除" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!--  Templates list  -->
                <Grid Grid.Row="1">
                    <ui:ListView
                        x:Name="TemplatesListBox"
                        AutomationProperties.AutomationId="PostGrabActions.TemplatesList"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="TemplatesListBox_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="220"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="範本名稱" />
                                <GridViewColumn Width="70" Header="區域">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Regions.Count}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn
                                    Width="300"
                                    DisplayMemberBinding="{Binding OutputTemplate}"
                                    Header="輸出範本" />
                                <GridViewColumn Width="140" Header="上次使用">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Opacity="0.7" Text="{Binding LastUsedDate, StringFormat={}{0:g}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ui:ListView>
                    <TextBlock
                        x:Name="NoTemplatesText"
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.6"
                        Text="尚未定義範本。按一下「開啟擷取框」，按住 Ctrl 並拖曳以繪製區域，然後按一下擷取框中的「另存為範本」。"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>

                <!--  Inline template editor (collapsed until Edit is clicked)  -->
                <Border
                    x:Name="TemplateEditPanel"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="0,8,0,0"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,8,4"
                            VerticalAlignment="Center"
                            Text="名稱：" />
                        <TextBox
                            x:Name="EditTemplateNameBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            Padding="4,2"
                            VerticalContentAlignment="Center" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,8,4"
                            VerticalAlignment="Center"
                            Text="輸出範本：" />
                        <TextBox
                            x:Name="EditOutputTemplateBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            Padding="4,2"
                            VerticalContentAlignment="Center"
                            FontFamily="Consolas"
                            ToolTip="使用 {1}、{2} 等代表區域值。使用 {1:trim}、{1:upper}、{1:lower} 設定格式。使用 \n 換行。" />

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ui:Button
                                x:Name="ApplyTemplateEditButton"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Click="ApplyTemplateEdit_Click"
                                Content="套用變更" />
                            <ui:Button
                                x:Name="CancelTemplateEditButton"
                                Click="CancelTemplateEdit_Click"
                                Content="取消" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  Bottom Buttons  -->
        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="16,8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="ResetButton"
                AutomationProperties.AutomationId="PostGrabActions.ResetButton"
                Margin="0,0,8,0"
                Click="ResetButton_Click"
                Content="重設為預設值"
                ToolTip="將擷取後動作重設為預設值" />
            <ui:Button
                x:Name="SaveButton"
                AutomationProperties.AutomationId="PostGrabActions.SaveButton"
                Margin="0,0,8,0"
                Appearance="Primary"
                Click="SaveButton_Click"
                Content="儲存"
                ToolTip="儲存變更並關閉" />
            <ui:Button
                x:Name="CancelButton"
                AutomationProperties.AutomationId="PostGrabActions.CancelButton"
                Click="CancelButton_Click"
                Content="取消"
                ToolTip="關閉而不儲存" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
