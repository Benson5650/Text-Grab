<ui:FluentWindow
    x:Class="Text_Grab.Controls.QrCodeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Text Grab QR Code"
    AutomationProperties.AutomationId="QrCodeDialog"
    Width="400"
    Height="600"
    Closing="FluentWindow_Closing"
    mc:Ignorable="d">
    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="UiTitleBar"
            Title="QR Code"
            Height="32"
            Margin="2,2,2,0"
            Padding="8,2"
            Icon="{StaticResource TextGrabIcon}" />
        <TextBox
            x:Name="QrCodeTextBox"
            AutomationProperties.AutomationId="QrCode.Content"
            Grid.Row="1"
            Margin="12,0"
            TextChanged="QrCodeTextBox_TextChanged" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <local:CollapsibleButton
                x:Name="SaveButton"
                AutomationProperties.AutomationId="QrCode.SaveButton"
                Margin="12,0,0,0"
                ButtonSymbol="Save24"
                ButtonText="PNG…"
                Click="SaveButton_Click" />
            <local:CollapsibleButton
                x:Name="SvgButton"
                AutomationProperties.AutomationId="QrCode.SaveSvgButton"
                ButtonSymbol="Save24"
                ButtonText="SVG…"
                Click="SvgButton_Click" />
            <local:CollapsibleButton
                x:Name="CopyButton"
                AutomationProperties.AutomationId="QrCode.CopyButton"
                ButtonSymbol="ImageCopy24"
                ButtonText="複製 PNG 至剪貼簿"
                Click="CopyButton_Click" />
        </StackPanel>
        <StackPanel
            Grid.Row="3"
            Height="36"
            Orientation="Horizontal">
            <TextBlock
                Margin="12,0"
                VerticalAlignment="Center"
                Text="錯誤更正層級" />
            <ComboBox
                x:Name="ErrorCorrectionComboBox"
                AutomationProperties.AutomationId="QrCode.ErrorCorrection"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                SelectionChanged="ErrorCorrectionComboBox_SelectionChanged">
                <ComboBoxItem
                    Content="低，最高 7%"
                    IsSelected="True"
                    Tag="L" />
                <ComboBoxItem Content="中，最高 15%" Tag="M" />
                <ComboBoxItem Content="高品質，最高 25%" Tag="Q" />
                <ComboBoxItem Content="最高，最高 30%" Tag="H" />
            </ComboBox>
        </StackPanel>
        <TextBlock
            x:Name="LengthErrorTextBlock"
            AutomationProperties.AutomationId="QrCode.Error"
            Grid.Row="4"
            Padding="20,4"
            HorizontalAlignment="Center"
            d:Visibility="Visible"
            FontWeight="Bold"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed">
            ⚠️ 文字已修剪至 QR Code 允許的最大長度。
        </TextBlock>
        <Image
            Name="CodeImage"
            AutomationProperties.AutomationId="QrCode.Image"
            Grid.Row="5"
            Margin="0"
            MouseLeftButtonDown="CodeImage_MouseLeftButtonDown" />
    </Grid>
</ui:FluentWindow>
