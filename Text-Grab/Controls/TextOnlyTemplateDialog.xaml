<ui:FluentWindow
    x:Class="Text_Grab.Controls.TextOnlyTemplateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="新增純文字範本"
    AutomationProperties.AutomationId="TextTemplateDialog"
    Width="520"
    Height="340"
    MinWidth="400"
    MinHeight="280"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />
    </Window.Resources>

    <Grid Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBarControl"
            Title="新增純文字範本"
            Height="32"
            Margin="2,2,2,0"
            Padding="8,2"
            Icon="{StaticResource TextGrabIcon}" />

        <StackPanel Grid.Row="1" Margin="12">
            <TextBlock Margin="0,0,0,4" Text="範本名稱：" />
            <TextBox
                x:Name="TemplateNameBox"
                AutomationProperties.AutomationId="TextTemplate.Name"
                Margin="0,0,0,12"
                TextChanged="ValidateInput" />

            <TextBlock Margin="0,0,0,4" Text="輸出（輸入 { 以選取）：" />
            <controls:InlinePickerRichTextBox
                x:Name="OutputTemplateBox"
                AutomationProperties.AutomationId="TextTemplate.Output"
                MinHeight="80"
                Margin="0,0,0,4"
                AcceptsReturn="True"
                AcceptsTab="True"
                TextChanged="OutputTemplateBox_TextChanged"
                ToolTip="輸入 { 以插入規則運算式預留位置，也支援純文字。"
                VerticalScrollBarVisibility="Auto" />

            <Grid Margin="0,2,0,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.6"
                    Text="輸入 { 以從已儲存的規則運算式中選取。使用 \n 換行。"
                    TextWrapping="Wrap" />
                <ui:Button
                    HorizontalAlignment="Right"
                    Appearance="Secondary"
                    Click="ManagePatternsButton_Click"
                    Content="新增規則運算式..."
                    Icon="{ui:SymbolIcon Add24}"
                    ToolTip="開啟規則運算式管理器以建立或編輯規則運算式" />
            </Grid>

            <TextBlock
                x:Name="ErrorText"
                AutomationProperties.AutomationId="TextTemplate.Error"
                Margin="0,6,0,0"
                Foreground="Red"
                Text=""
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="12,0,12,12"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="SaveButton"
                AutomationProperties.AutomationId="TextTemplate.SaveButton"
                Margin="0,0,6,0"
                Appearance="Primary"
                Click="SaveButton_Click"
                Content="儲存"
                IsEnabled="False" />
            <ui:Button Click="CancelButton_Click" Content="取消" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
