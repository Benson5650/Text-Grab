<UserControl
    x:Class="Text_Grab.Controls.ExternalLinkConfirmationContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="420"
    AutomationProperties.AutomationId="ExternalLink.ConfirmationContent"
    PreviewKeyDown="Content_PreviewKeyDown"
    Unloaded="Content_Unloaded">
    <StackPanel>
        <TextBlock
            x:Name="ActionDescription"
            Margin="0,0,0,12"
            TextWrapping="Wrap" />
        <TextBlock Margin="0,0,0,4" Text="連結詳細資料：" />
        <TextBox
            x:Name="TargetTextBox"
            MaxHeight="160"
            AutomationProperties.AutomationId="ExternalLink.Target"
            AutomationProperties.Name="完整連結詳細資料"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
            <Button
                x:Name="WarningButton"
                Width="32"
                Height="32"
                Padding="4"
                AutomationProperties.AutomationId="ExternalLink.WarningButton"
                AutomationProperties.HelpText="僅開啟您信任來源的電子郵件與電話連結。這些連結會開啟其他應用程式，並可能準備寄送訊息或撥打電話。"
                AutomationProperties.Name="連結安全性警告"
                Background="Transparent"
                BorderThickness="0"
                Click="WarningButton_Click"
                ToolTip="只有在信任來源時才開啟連結。">
                <ui:SymbolIcon
                    FontSize="22"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
            </Button>
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="只有在信任來源時才繼續。" />
            <Popup
                x:Name="WarningPopup"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=WarningButton}"
                StaysOpen="False">
                <Border
                    Padding="12"
                    Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBlock
                        Width="340"
                        AutomationProperties.AutomationId="ExternalLink.WarningText"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="只有在信任文字或影像來源時才開啟此連結。OCR、剪貼簿或文件中的連結可能由他人提供。繼續前請檢查完整連結：電子郵件連結可能預先填入訊息，電話連結則可能撥出電話、產生費用或揭露您的電話號碼。"
                        TextWrapping="Wrap" />
                </Border>
            </Popup>
        </StackPanel>
        <CheckBox
            x:Name="DontWarnAgainCheckBox"
            Margin="0,12,0,0"
            AutomationProperties.AutomationId="ExternalLink.DontWarnAgain"
            AutomationProperties.HelpText="您可以在「設定」→「進階風險選項」→「外部連結」重新啟用此提醒。" />
    </StackPanel>
</UserControl>
