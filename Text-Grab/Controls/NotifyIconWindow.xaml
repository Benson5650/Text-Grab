<Window
    x:Class="Text_Grab.Controls.NotifyIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:WpfUiIcon="http://schemas.lepo.co/wpfui/2022/xaml/tray"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="NotifyIconWindow"
    AutomationProperties.AutomationId="NotifyIconWindow"
    Width="0"
    Height="0"
    Background="Transparent"
    IsHitTestVisible="False"
    Left="-50"
    Loaded="Window_Loaded"
    Opacity="0"
    ShowActivated="False"
    ShowInTaskbar="False"
    Top="-50"
    Visibility="Hidden"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <WpfUiIcon:NotifyIcon
            x:Name="NotifyIcon"
            AutomationProperties.AutomationId="NotifyIcon"
            AutomationProperties.Name="Text Grab 通知圖示"
            Icon="/Images/TealSelect40.png"
            IsVisibleChanged="NotifyIcon_IsVisibleChanged"
            LeftClick="NotifyIcon_LeftClick"
            TooltipText="Text Grab">
            <WpfUiIcon:NotifyIcon.Menu>
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem
                        x:Name="SettingsMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.Settings"
                        Click="SettingsMenuItem_Click"
                        Header="設定">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="Settings24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="OpenFileMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.OpenFile"
                        Click="OpenFileMenuItem_Click"
                        Header="開啟檔案...">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="Document24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="OpenClipboardImageGrabFrame"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.PasteGrabFrame"
                        Click="OpenClipboardImageGrabFrame_Click"
                        Header="貼上至擷取框"
                        IsEnabled="False">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="ImageEdit24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="LastGrabMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.EditLastGrab"
                        Click="LastGrabMenuItem_Click"
                        Header="編輯上次擷取">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="ImageEdit24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="LookupMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.QuickLookup"
                        Click="LookupMenuItem_Click"
                        Header="快速查詢">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="TextBulletListSquareSearch20" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="PreviousRegionMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.PreviousRegion"
                        Click="PreviousRegionMenuItem_Click"
                        Header="再次擷取上一個區域">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="History24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="FullscreenGrabMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.FullscreenGrab"
                        Click="FullscreenGrabMenuItem_Click"
                        Header="全螢幕擷取">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="SlideAdd24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="GrabFrameMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.GrabFrame"
                        Click="GrabFrameMenuItem_Click"
                        Header="擷取框">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="PanelBottom20" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="LastEditWindow"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.LastEditText"
                        Click="LastEditWindow_Click"
                        Header="上次文字編輯視窗">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="History20" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="EditWindowMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.EditText"
                        Click="EditWindowMenuItem_Click"
                        Header="文字編輯視窗">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="WindowEdit20" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="CloseMenuItem"
                        AutomationProperties.AutomationId="NotifyIcon.Menu.Close"
                        Click="Exit_Click"
                        Header="關閉 Text Grab">
                        <MenuItem.Icon>
                            <wpfui:SymbolIcon Symbol="Dismiss24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </WpfUiIcon:NotifyIcon.Menu>
        </WpfUiIcon:NotifyIcon>
    </Grid>
</Window>
