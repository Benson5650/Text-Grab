<Application
    x:Class="Text_Grab.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Text_Grab"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Exit="appExit"
    ShutdownMode="OnExplicitShutdown"
    Startup="appStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  TODO: Remove this when proper theme setting is fixed  -->
                <ResourceDictionary>
                    <Color
                        x:Key="SystemAccentColor"
                        A="255"
                        B="152"
                        G="142"
                        R="48" />
                    <Color
                        x:Key="SystemAccentColorPrimary"
                        A="255"
                        B="152"
                        G="142"
                        R="48" />
                    <Color
                        x:Key="SystemAccentColorSecondary"
                        A="255"
                        B="152"
                        G="142"
                        R="48" />
                    <Color
                        x:Key="SystemAccentColorTertiary"
                        A="255"
                        B="152"
                        G="142"
                        R="48" />

                </ResourceDictionary>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Styles/ListViewScrollFix.xaml" />
                <ResourceDictionary Source="/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Styles/TextStyles.xaml" />
                <ResourceDictionary Source="/Styles/SettingsStyles.xaml" />
                <ResourceDictionary Source="/Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="/Styles/TextBoxStyles.xaml" />
                <ResourceDictionary Source="/Styles/GridViewStyles.xaml" />
                <ResourceDictionary Source="/Styles/DataGridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:UiEnumDisplayConverter x:Key="UiEnumDisplayConverter" />
            <ControlTemplate x:Key="MenuItemTemplate1" TargetType="{x:Type MenuItem}">
                <Grid />
            </ControlTemplate>
            <Style TargetType="{x:Type Menu}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Menu}">
                            <Border Margin="0,-10" BorderThickness="1">
                                <StackPanel
                                    ClipToBounds="True"
                                    IsItemsHost="True"
                                    Orientation="Horizontal" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </Application.Resources>
    <JumpList.JumpList>
        <JumpList>
            <JumpTask
                Title="設定"
                Arguments="Settings"
                Description="開啟 Text Grab 設定" />
            <JumpTask
                Title="快速查詢"
                Arguments="QuickLookup"
                Description="快速搜尋簡單、彈性的值清單" />
            <JumpTask
                Title="文字編輯"
                Arguments="EditText"
                Description="開啟文字編輯視窗" />
            <JumpTask
                Title="擷取框"
                Arguments="GrabFrame"
                Description="開啟擷取框以搜尋並選取文字" />
            <JumpTask
                Title="全螢幕擷取"
                Arguments="Fullscreen"
                Description="使用全螢幕覆蓋層選取文字" />
        </JumpList>
    </JumpList.JumpList>
</Application>
